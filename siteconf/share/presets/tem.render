#!/usr/bin/env perl
# HAVE: @PATH@
# NEED: ${B}/MY/option.mk
#
# (Note that we do not "NEED" MY/config.mk; doing so
# would declare an undesirable dependency edge that
# undermines the very point of separating these two.
#
# We do depend on it to be very clear; it's just that
# we don't need to re-render stuff when it changes.)
#
# @NAME@ - Template Toolkit renderer
#
# To invoke this, add to your Makefile.in (or whatever
# you set your "R" path to):
#
#    page.txt: @PATH@
#       cd -- $A && ${^X} @PATH_Q@ -B $B \
#          -- $a/${.IMPSRC} $B/$b/${.TARGET}
#
# (Multiple files are okay!)
#
# More information about Template Toolkit here:
# https://template-toolkit.org/
#
use utf8;
use 5.008;
use strict;
use warnings;

use Encode ();
use RdKw::I18N::CodeSets ();
use Getopt::Long qw( GetOptions );
use RdKw::WwW::GenGenLib 0.0100 qw( load_state );
use Template;
@USE_PROVIDER@use RdKw::L10N::TextDomain ':module' => 'RdKw::WwW::SiteConf::L10N';

my $cs = RdKw::I18N::CodeSets->new();
# Command-line arguments are decoded via the
# argv codeset, though this may be altered by
# the SITECONF_CODESETS and -C flags, so we
# must parse them.
$cs->parse_from_env('SITECONF_CODESETS', prog => $0);
my $offset = $cs->parse_from_argv(\@ARGV, prog => $0);

# Parsing is complete; we can publish them for
# everyone else.
RdKw::I18N::CodeSets->locale($cs);
$cs->initstd(stderr => Encode::FB_PERLQQ());
my $prog = $cs->un_argv($0, { check => Encode::FB_PERLQQ() });
@ARGV = $cs->un_argv(@ARGV, { start => 1 + $offset, prog => $prog });

Getopt::Long::Configure(qw( bundling no_ignore_case ));
my $B = '.';
GetOptions(
	'B=s' => \$B,
	# Explicitly reject stray -C options.
	'C:s' => sub { die "$prog: " . __("too late to -C now.") . "\n" },
)
# The usage may be altered, so we only translate the "usage:" part.
	or die $cs->diag(__("usage: %s"),
	"$prog [-B dir] apath bpath") . "\n";
# HEY!  The usage is `./render apath bpath', which is two arguments.
@ARGV == 2 or die "$prog: " . __("need exactly two args") . "\n";
my ($apath, $bpath) = @ARGV;

my %S = load_state($B);
my %v = (
	D => $S{config},
	O => $S{option},
);
my $D = $S{config};

#
# UTF-8 on both ends: ENCODING for what is read (the source,
# and what it INCLUDEs), binmode for what is written.
#
@TT_NEW@
$tt->process(@APATH_FS@, \%v, $cs->to_fs($bpath, { prog => 'E' }),
	{ binmode => ':encoding(UTF-8)' })
	or die "[TT] ", $tt->error(), "\n";

exit 0;  # goodbye!
