#!perl

use 5.008;
use strict;
use warnings;

=head1 NAME

siteconf - configurable incremental build script generator

=head1 SYNOPSIS

    siteconf -i [-P preset] [-o [name:]path ...] [-f] [-Sopt=val ...]
             [-Dvar=val ...] [-Ovar=val ...]
    siteconf init ...                         # same

    #
    # -S: where things are, baked into ./configure as defaults
    #
    # path to project root, seen from where ./configure is run
    #   -SA=.       (default)
    #   -SA=..      (alternatively if we live in a subdirectory
    # path to build dir, seen from the project root $A, or absolute
    #   -SB=.       (default)
    #   -SB=build   (CMake style)
    #   -SB=/tmp/writable/build/dir  (read-only checkout)
    # path to transformation rules, relative to where `siteconf -g' is run
    #   -SR=Makefile.in (default)
    # path to top-level manifest, likewise
    #   -SF=MANIFEST  (default)
    # path to source tree relative to $A
    #   -Sa=html    (default, since we originate from SSG.)
    #   -Sa=.       (a sane alternative)
    # path to output tree relative to $B
    #   -Sb=site    (default)
    # directory marker
    #   -Se=.ok     (default)
    #   -Se=.exists (mimics EU::MM)
    #
    # -D, -O: defaults for definitions and options (see ./configure -h)
    #
    # -P: preset, such as web or tem (the default is none)
    #

    ./configure [-DB=outdir] [-Db=reldir] [-Ovar=val ...]

    siteconf -g [-B outdir] [-G make|gmake|ninja] [-q]
    siteconf make ...                         # same
    cd ${B} && [make|gmake|ninja] [goal]   # ninja -t clean to clean

=head1 DESCRIPTION

C<siteconf -i> writes F<configure>.  F<configure> writes
F<${B}/MY/config.mk> (I<definitions>, which are only filesystem
routing) and F<${B}/MY/option.mk> (I<options>, which alter the
state of the build, and which whatever is transformed may depend on).

C<siteconf -g> reads those, along with the rules (F<Makefile.in>)
and the F<MANIFEST> they were pointed at (as seen from where you run
it: they are not part of the source tree), and writes the build file
in I<${B}>, and F<MY/MANIFEST.I<goal>> for each goal in the manifest.
See L<RdKw::WwW::SiteConf> for what those look like.

With the C<web> preset (C<-P web>), F<siteconf -i> also writes a plain
F<render> script next to the rules (in C<-SA>, which is the current directory
by default), unless one is already there (use C<-f> to overwrite).  F<configure> requires an
C<-Osite_url>, and sees to it that C<base_url> agrees.  The files
are rendered through Template Toolkit; by convention with the
namespaces C<D> and C<O>, the variable C<location>, and the function
C<locate>, though it is each F<render> that decides;
see L<RdKw::WwW::GenLib/SYNOPSIS>.

The C<tem> preset (C<-P tem>) is the same without the web: F<render>
gives a template C<D> and C<O>, and nothing else, and F<configure>
asks for no options (nor GenLib).  It needs GenGenLib 0.0100.

For the generated script, see L<RdKw::WwW::SiteConf::Configure>.

File names and arguments are read as the locale says, and messages
are written that way too (what cannot be said there is written as
C<\x{...}>).  An argument or a name that the locale cannot spell is
an error.  What is in the files we read and write is always UTF-8.

=head1 OPTIONS

=over

=item B<-i>, B<init>

Write F<configure> (or whatever I<-o> says).

=item B<-M> I<module>[=I<version>]

Have F<configure> check that I<module> can be loaded (and is at
least I<version>, if given) before doing anything else.  May be
given more than once; a later one for the same module replaces
the earlier.  F<configure> always checks for L<Encode::Locale> and
L<RdKw::WwW::GenGenLib> (version 0.0100, which spells file names as
the locale does, and which F<render> needs; give
C<-MRdKw::WwW::GenGenLib=0> to get an older F<render> that works with
any version, and C<=0.0002> for one that does not mind the locale),
and so does the preset for what it needs (C<# USE:>
lines in its config).  C<-M>I<module>C<=> with nothing after the C<=>
drops I<module> from the list, even one the preset asked for.

C<-MRdKw::WwW::GenGenLib::Template::Provider> (which nothing asks for,
and nothing needs) has F<render> load templates through it: what a page
C<INCLUDE>s (or C<PROCESS>es, C<WRAPPER>s, C<INSERT>s) must be declared
in its header, or in the header of what that declares, and so on; and
the names are spelled as the locale says.  It needs GenGenLib 0.0100.

=item B<-g>, B<make>

Write the build file, reading the configuration from C<-B>
(the current directory by default).

=item B<-B> I<dir>

The build directory, as seen from here.  Everything else is derived
from F<MY/config.mk> there, so it does not matter from where this is
run.

=item B<-G> I<generator>

C<make> (default), writing F<Makefile>; C<gmake>, writing one for GNU
make, which can name files that make cannot (with blanks, C<#>, C<:>,
C<$>, wildcards and so on: see L<RdKw::WwW::SiteConf::GMake>); or
C<ninja>, writing F<build.ninja>.  A name that the generator cannot
spell is an error.

=item B<-o> I<file>

With C<-g>, write I<file> in the build directory instead of F<Makefile>
(or F<build.ninja>); say C<make -f Makefile.proj> to use it.  Just a
name, not a path.

With C<-i>, may be repeated as C<-o name:path>, where I<name> is
C<configure> or C<render>.  Bare C<-o path> means C<-o configure:path>.
The last mapping for each name wins.  Only the first colon separates
name from path.  Prefix a bare filename containing a colon with C<./>.
Unknown names and empty paths are errors.  Parent directories must exist.

F<configure> goes in the current directory, or wherever its mapping says
(seen from here, or absolute).  F<render> goes in the project root
(C<-SA>), and a mapping for it names it as seen from there -- the same
name that it declares as its C<HAVE> and that the rulebook uses.  Since
that name ends up in a C<HAVE>, it may not contain white space (space,
tab, newline, vertical tab, form feed, carriage return; a no-break space
is no white space), begin with C<">, or end with C<"> or C<?>.

A destination of F</dev/null> suppresses that output.  Mapping C<render>
requires a preset that supplies it.  Existing files are left alone unless
C<-f> is passed, including at explicitly mapped destinations.

For example:

    siteconf init -P web -o configure:tools/configure \
        -o render:bin/render-page

This does not rewrite your rulebook.  Update its renderer path in both
the dependency and the recipe.  (The renderer's own header C<NEED>s
F<MY/option.mk>, so option changes still rebuild its targets.)

    index.html: ${A}/bin/render-page
        cd ${A:Q} && ${^X} bin/render-page -B ${B:Q} ${a}/index.html ${B:Q}/${b}/index.html

Named mappings are only for C<-i>.

=item B<-f>

With C<-i>, overwrite existing configure and renderer files.  Without it,
existing files are skipped, and processing continues.  F</dev/null> still
suppresses an output even with C<-f>.  New files are reported as C<Wrote>,
and replaced files as C<Overwrote>.

An existing file that is skipped is reported as C<Not changing>.  Init
fails (status 1) if F<configure> already exists and was therefore not
written; suppressing it with F</dev/null> is not a failure, and neither
is a skipped renderer.

=item B<-q>, B<--quiet>

Say nothing but errors: not the C<WANT>s that were dropped, nor the
files that are written, updated, or removed, nor what to run to
build.  (F<configure> takes C<-q> too.)

=item B<-F> I<manifest>

Specifies a different manifest to use.
Overrides the configured C<F>.  Like it, this is a path from the
current directory (not from C<${A}>, like everything else).

=item B<-R> I<rulebook>

Specifies a different rulebook to use.
Overrides the configured C<R>.  Like it, this is a path from the
current directory.

=back

=cut

use version;

use Data::Dumper ();
use File::Basename qw( basename dirname );
use File::ShareDir ();
use File::Spec;
use Getopt::Long qw( GetOptionsFromArray );

use Encode ();
use Encode::Locale ();
use PerlIO::encoding ();
use RdKw::WwW::GenGenLib qw( to_fs un_fs escape_dep );
use RdKw::WwW::SiteConf;

# GenLib with non-broken varargs locate
our $GENLIB_NEW = '0.0203';
# GenGenLib with norm_dep, subs_dep and uproot.
our $GENGENLIB_NEW = '0.0002';
# GenGenLib that is locale-aware
our $GENGENLIB_LOCALE = '0.0100';
# Our preferred provider, if (and only if) the user requests it via -M
our $PROVIDER = 'RdKw::WwW::GenGenLib::Template::Provider';

# The minimum version a preset's render supports: -P tem is here
# due to its belated inclusion, while -P web isn't because it has
# been around for much longer.
my %PRESET_GENGENLIB = ( tem => $GENGENLIB_LOCALE );

# What we say is for people: as the locale says, or \x{...} where it
# cannot (rather than a warning about each one)
{
	local $PerlIO::encoding::fallback = Encode::PERLQQ();
	binmode STDOUT, ':encoding(console_out)';
	binmode STDERR, ':encoding(console_out)';
}

my $prog = un_fs(basename($0));
my $usage = <<EOM;
usage: $prog -i [-P preset] [-o [name:]path ...] [-fq] [-Mmodule[=version] ...]
                [-Sopt=val ...] [-Dvar=val ...] [-Ovar=val ...]
       $prog -g [-B builddir] [-G generator] [-F manifest] [-R rulebook] [-o file] [-q]
       $prog -V [-V]
EOM

Getopt::Long::Configure(qw( bundling no_ignore_case ));
eval { $_ = Encode::decode(locale => $_, Encode::FB_CROAK()) for @ARGV; 1 }
	or die "$prog: cannot decode argv in current locale"
		. " ($Encode::Locale::ENCODING_LOCALE)\n";

my %opt = (S => {}, D => {}, O => {}, M => [], outputs => []);
# What `-i' was told, in the order it was told, for the header of
# configure.  (Leaving out what does not alter its text: -i, -o, -f, -q.)
my @written;
GetOptions(
	'i|init'   => sub { $opt{mode} = 'init' },
	'g|make'   => sub { $opt{mode} = 'make' },
	'P=s'      => sub { $opt{P} = $_[1]; push @written, "-P", $_[1] },
	'o=s'      => sub { push @{ $opt{outputs} }, $_[1] },
	'M=s'      => sub { push @{ $opt{M} }, $_[1]; push @written, "-M$_[1]" },
	'B=s'      => \$opt{B},
	'G=s'      => \$opt{G},
	'S=s%'     => sub { $opt{S}{$_[1]} = $_[2]; push @written, "-S$_[1]=$_[2]" },
	'D=s%'     => sub { $opt{D}{$_[1]} = $_[2]; push @written, "-D$_[1]=$_[2]" },
	'O=s%'     => sub { $opt{O}{$_[1]} = $_[2]; push @written, "-O$_[1]=$_[2]" },
	'F=s'      => \$opt{F},
	'R=s'      => \$opt{R},
	'h|help'   => sub { print $usage; exit 0 },
	'V|version+' => \( my $vee ),
	'q|quiet'  => \$opt{q},
	'f'        => \$opt{f},
) or die $usage;

if ($vee) {
	print <<VAR;
$prog version $RdKw::WwW::SiteConf::VERSION
VAR

	exit unless $vee > 1;
	print <<LVER;
perl version $], @{[ un_fs($^X) ]}
WwW::GenGenLib version $RdKw::WwW::GenGenLib::VERSION
LVER

	foreach my $fren (qw( Template URI URI::Escape RdKw::WwW::GenLib )) {
		(my $path = "$fren.pm") =~ s!::!/!g;
		eval { require $path; 1 } or next;
		(my $cheeky = $fren) =~ s/^RdKw:://;
		# Obtain version without using symbolic ref :x
		print "$cheeky version " . $fren->VERSION() . "\n";
	}
	exit;
}

# `siteconf init', `siteconf make'
if (@ARGV and $ARGV[0] =~ /\A(?:init|make)\z/) {
	my $word = shift @ARGV;
	defined $opt{mode} and $opt{mode} ne $word
		and die "$prog: conflicting modes: $opt{mode} and $word\n";
	$opt{mode} = $word;
}
defined $opt{mode} or die $usage;
@ARGV and die "$prog: too many arguments\n";

# Keep output routing separate from the defaults written into configure.
for my $output (@{ $opt{outputs} }) {
	my ($name, $path) = ('configure', $output);
	if ($output =~ m!\A([^/:]+):(.*)\z!s) {
		($name, $path) = ($1, $2);
		$opt{mode} eq 'init'
			or die "$prog: named outputs are only for init\n";
		$name eq 'configure' || $name eq 'render'
			or die "$prog: unknown output name: $name\n";
	}
	length $path or die "$prog: empty output path\n";
	$opt{mode} eq 'init' ? ($opt{output}{$name} = $path) : ($opt{o} = $path);
}

if ($opt{mode} eq 'init') {
	for my $k (qw( B F G R )) {
		defined $opt{$k} and die "$prog: -$k is not for init\n";
	}
	$opt{written} = \@written;
	exit do_init(\%opt);
} else {
	for my $k (qw( P f )) {
		defined $opt{$k} and die "$prog: -$k is not for make\n";
	}
	@{ $opt{M} } and die "$prog: -M is not for make\n";
	for my $S (qw( S D O )) {
		%{ $opt{$S} } and die "$prog: -$S is not for make\n";
	}
	my %Doverrides;
	foreach my $Dk (qw( F R )) {
		if (defined $opt{$Dk}) {
			$Doverrides{$Dk} = $opt{$Dk};
		}
	}
	my $sc = RdKw::WwW::SiteConf->new(
		%Doverrides ? ( D => \%Doverrides ) : (),
		B => $opt{B},
		quiet => $opt{q},
		prog => $prog,
	);
	$sc->generate($opt{G}, $opt{o});
}
exit;

# ---

# `share' lives where File::ShareDir finds it: alongside the modules
# we were loaded from (so under blib/ in a built checkout), and nowhere
# else.  No environment variable, no path relative to us.
sub share_file
{
	my ($file) = @_;
	my $path = eval { File::ShareDir::dist_file('WwW-SiteConf', $file) };
	defined $path or die "$prog: cannot find share/$file (is WwW-SiteConf installed?)\n";
	un_fs($path, $prog);
}

sub slurp
{
	my ($file) = @_;
	open my $fh, '<:encoding(UTF-8)', to_fs($file, $prog)
		or die "$prog: open <$file: $!\n";
	my $text = do { local $/; readline $fh };
	close $fh or die "$prog: read <$file: $!\n";
	$text;
}

# A Perl string literal
sub pq
{
	my ($s) = @_;
	Data::Dumper->new([$s])->Terse(1)->Indent(0)->Useqq(1)->Dump();
}

# Perl key preceding a fat comma
sub pK
{
	my ($K) = @_;
	($K !~ /[^0-9A-Z_a-z]/) ? $K : pq($K);
}

sub hash_lines
{
	my ($H) = @_;
	join "\n", map {
		"\t@{[ pK($_) ]} => @{[ pq($H->{$_}) ]},"
	} sort keys %$H;
}

# What `-i' was told, as comment lines (none, if it was told nothing)
sub args_comment
{
	my ($args) = @_;
	return '' unless @$args;
	my $line = join ' ', map { RdKw::WwW::SiteConf::shell_quote($_) } @$args;
	$line =~ s/\n/\n# /g;
	"# options: $line\n#\n";
}

sub do_init
{
	my ($opt) = @_;
	my %S = %{ $opt->{S} };

	# What -S sets: where we are, and the defaults for A B a b c R F e clean.
	my %Dd = (
		A => '.',
		B => '.',
		a => 'html',
		b => 'site',
		R => 'Makefile.in',
		F => 'MANIFEST',
		e => '.ok',
		clean => 'clean',
	);
	# Well-known options
	my %OD = (
		base_url => q{Host-relative base URL},
		site_url => q{Absolute base URL},
	);
	for my $k (keys %S) {
		exists $Dd{$k} || $k eq 'c' or die "$prog: -S$k: no such thing"
			. " (valid: A B a b c R F e clean)\n";
		$Dd{$k} = $S{$k};
		length $Dd{$k} or die "$prog: -S$k may not be empty.\n";
	}
	File::Spec->file_name_is_absolute($Dd{b})
		and die "$prog: -Sb must be a relative path.\n";
	# c is always there; the same as b means it goes where b goes
	exists $Dd{c} or $Dd{c} = $Dd{b};
	File::Spec->file_name_is_absolute($Dd{c})
		and die "$prog: -Sc must be a relative path.\n";

	# -D and -O set what defaults to have in addition.
	for my $k (sort keys %{ $opt->{D} }) {
		exists $opt->{S}{$k}
			and die "$prog: -S$k and -D$k are the same thing; pick one.\n";
	}
	my %Dx = (%Dd, %{ $opt->{D} });
	# (-Db here moves c too, unless c is said)
	exists $S{c} || exists $opt->{D}{c} or $Dx{c} = $Dx{b};
	# -SA or -DA: where render goes, too
	my $A = $Dx{A};
	length $A or die "$prog: -DA may not be empty.\n";
	my %Ox = %{ $opt->{O} };

	my $preset = '';
	my $help = '';
	my $dhelp = '';
	my $render;
	if (defined $opt->{P} and $opt->{P} ne 'none') {
		$opt->{P} =~ /\A\w+\z/ or die "$prog: bad preset name: $opt->{P}\n";
		my $file = eval { share_file("presets/$opt->{P}.config") }
			or die "$prog: no such preset: $opt->{P}\n";
		$preset = slurp($file);
		$preset =~ s/\n*\z/\n/;
		$render = eval { share_file("presets/$opt->{P}.render") };
	}
	# configure must find these: what the preset says (in `# NEED:
	# module[=version]' lines), then -Mmodule or -Mmodule=version.  Keyed
	# by module, so that a later one replaces the earlier.  -Mmodule= with
	# nothing after the = drops it.
	my %mods = (
		'Encode::Locale' => 0,
		'RdKw::WwW::GenGenLib' => $GENGENLIB_LOCALE,
	);
	my @spec = ($preset =~ /^# USE: (\S+)$/mg, @{ $opt->{M} });
	my %user;
	for my $m (@spec) {
		my ($module, $min) = split /=/, $m, 2;
		$min = 0 unless defined $min;
		$module =~ /\A\w+(?:::\w+)*\z/ or die "$prog: -M$m: bad module name\n";
		$min =~ /\A(?:v?[0-9][0-9._]*|0|)\z/ or die "$prog: -M$m: bad version\n";
		if ($min eq '') {
			$module eq 'RdKw::WwW::GenGenLib' || $module eq 'Encode::Locale'
				and die "$prog: -M$m: configure always needs it\n";
			delete $mods{$module};
		} else {
			$mods{$module} = $min;
		}
		$user{$module} = 1;
	}
	# Test how far we could go, with user overrides taken into account.
	if (defined $render) {
		$user{'RdKw::WwW::GenGenLib'}
			or version_ge($mods{'RdKw::WwW::GenGenLib'}, $GENGENLIB_NEW)
			or $mods{'RdKw::WwW::GenGenLib'} = $GENGENLIB_NEW;
		$opt->{gengenlib_min} = $mods{'RdKw::WwW::GenGenLib'};
		if (defined(my $least = $PRESET_GENGENLIB{$opt->{P}})) {
			version_ge($opt->{gengenlib_min}, $least)
				or die "$prog: -P $opt->{P} needs RdKw::WwW::GenGenLib $least\n";
		}
		# (what the preset said, if it says anything: -P tem does not)
		$opt->{genlib_min} = $mods{'RdKw::WwW::GenLib'};
		# (only ever because -M said so: no preset asks for it)
		$opt->{provider} = $user{$PROVIDER} && exists $mods{$PROVIDER};
	}
	my @mod = map { "\t\t[ " . pq($_) . ", " . pq($mods{$_}) . " ]," } sort keys %mods;
	exists $opt->{output}{render} && !defined $render
		and die "$prog: preset does not supply a render output\n";
	# render names itself in a HAVE, and read_deps cannot take just
	# anything there (" is reserved for an escape mechanism, and ?
	# is for soft-deps).
	if (defined(my $path = $opt->{output}{render})) {
		$path eq '' || $path =~ /\A"/ || $path =~ /[?"]\z/ || $path =~ /[\t\n\cK\f\r ]/
			and die "$prog: dangerous name for render: @{[pq($path)]} "
				. "is not supported (yet)\n";
	}
	# -D beyond B a b R F e clean (which configure already describes)
	my @Dextra = grep { !exists $Dd{$_} && $_ ne 'c' } sort keys %Dx;
	if (@Dextra) {
		$dhelp = join '', map { sprintf "  -D%-9s (default: \$Dd{%s})\n", $_, pK($_) }
			@Dextra;
	}
	if (%Ox) {
		$help = "\nOptions with defaults:\n\n" .
			join '', map {
				sprintf "  -O%-9s %s(default: \$Od{%s})\n",
					$_, exists $OD{$_} ? "$OD{$_} " : "", pK($_)
			} sort keys %Ox;
	}

	my $text = slurp(share_file('configure.in'));
	my %sub = (
		PROG => $prog,
		VERSION => $RdKw::WwW::SiteConf::VERSION,
		ARGS => args_comment($opt->{written}),
		DDEF => hash_lines(\%Dx),
		ODEF => hash_lines(\%Ox),
		MODULES => join("\n", @mod),
		PRESET => $preset,
		DEFHELP => $dhelp,
		OPTHELP => $help,
	);
	$text =~ s/@(\w+)@/exists $sub{$1} ? $sub{$1} : die "$prog: config template: \@$1\@?\n"/ge;

	my $out = exists $opt->{output}{configure} ? $opt->{output}{configure} : 'configure';
	my %out = ( configure => $out );
	if (defined $render) {
		my $name = defined $opt->{output}{render} ? $opt->{output}{render} : 'render';
		my $dest = $name eq '/dev/null' ? $name : File::Spec->catfile($A, $name);
		$out{render} = $dest;
	}

	my %written;
out:	while (my ($name, $dest) = each %out) {
		next if $dest eq '/dev/null';
		my $dest_fs = to_fs($dest, $prog);
		my $exists = (-e $dest_fs || -l $dest_fs);
		if (!$opt->{f} && $exists) {
			print STDERR "Not changing $dest\n" unless $opt->{q};
			next out;
		}
		if ($exists && !(-l $dest_fs || unlink $dest_fs)) {
			print STDERR "$prog: unlink $dest: $!\n" unless $opt->{q};
		}
		my $contents;
		if ($name eq 'configure') {
			$contents = $text;
		} elsif ($name eq 'render') {
			$contents = render_text($opt, $render);
		} else {
			die "Unreachable\n";
		}
		open my $fh, '>:encoding(UTF-8)', $dest_fs or die "$prog: open >$dest: $!\n";
		print $fh $contents or die "$prog: write >$dest: $!\n";
		close $fh or die "$prog: write >$dest: $!\n";
		unless (chmod 0777 & ~umask, $dest_fs) {
			print STDERR "$prog: chmod $dest: $!\n" unless $opt->{q};
		}
		$written{$name} = 1;
		print STDERR ($exists ? "Overwrote" : "Wrote"), " $dest\n" unless $opt->{q};
	}
	unless ($written{configure} || $out{configure} eq '/dev/null') {
		print STDERR
			"E: You already have configure"
			.  ($out{configure} eq 'configure' ? "" : " at \`$out{configure}'")
			. ".\n"
			. "E: Pass -o /dev/null if you did mean to not generate configure,\n"
			. "E: or -f to overwrite the existing one.\n"
			unless $opt->{q};
		return 1;
	}
	return 0;
}

sub version_ge
{
	my ($have, $want) = @_;
	my $ok = eval { version->parse($have) >= version->parse($want) };
	$ok ? 1 : 0;
}

# Generates <preset>.render.
sub render_text
{
	my ($opt, $render) = @_;
	my ($path, $name, $path_q);
	if (defined $opt->{output}{render}) {
		$path = $opt->{output}{render};
		$name = basename($path) eq 'render'
			? 'render' : "$path (render)";
	} else {
		$path = 'render';
		$name = 'render';
	}
	$path_q = RdKw::WwW::SiteConf::shell_quote($path);
	my $text = slurp($render);
	my $can_subst = version_ge($opt->{gengenlib_min}, $GENGENLIB_NEW);
	my $can_valoc = version_ge($opt->{genlib_min}, $GENLIB_NEW);
	my $can_locale = version_ge($opt->{gengenlib_min}, $GENGENLIB_LOCALE);
	my $provider = $opt->{provider};
	$provider && !$can_locale
		and die "$prog: -M$PROVIDER needs RdKw::WwW::GenGenLib $GENGENLIB_LOCALE\n";
	my %sub = (
		# (a spec, in its HAVE and in Makefile.in: a $ is a $)
		PATH => escape_dep($path, unicode => 1),
		PATH_Q => $path_q,
		NAME => $name,
		PERL_MIN => $can_locale ? '5.008' : '5.006',
		USE_LOCALE => $can_locale ? <<\NEW : '',

use Encode ();
use Encode::Locale ();
use PerlIO::encoding ();

# Use locale encoding for wide-characters, since console
# output/error is often meant for humans and not machine-
# consumable.  Fall back to ASCII \x{...} when a Unicode
# character cannot be encoded, however.
{
	local $PerlIO::encoding::fallback = Encode::PERLQQ();
	binmode STDOUT, ':encoding(console_out)';
	binmode STDERR, ':encoding(console_out)';
}
NEW
		DECODE_ARGV => $can_locale ? <<\NEW : '',
eval { Encode::Locale::decode_argv(Encode::FB_CROAK()); 1 }
	or die "$0: cannot read the arguments in this locale\n";
NEW
		USE_GENGENLIB => $can_locale
			? "use RdKw::WwW::GenGenLib $GENGENLIB_LOCALE qw(
	read_deps load_state
	norm_dep subs_dep uproot to_fs );"
			: $can_subst
			? "use RdKw::WwW::GenGenLib $GENGENLIB_NEW qw(
	read_deps load_state
	norm_dep subs_dep uproot );"
			: 'use RdKw::WwW::GenGenLib qw( read_deps load_state );',
		# Template opens the files itself: by the names
		# the file system knows them by.
		# (the provider names files itself)
		APATH_FS => $can_locale && !$provider ? "to_fs(\$apath, 'E')" : '$apath',
		USE_PROVIDER => $provider ? "use $PROVIDER;\n" : '',
		TT_NEW => $provider
			? <<"NEW"
# This provider encodes file paths to the system locale,
# and additionally grants access to named dependencies
# that are declared in the same headers siteconf reads.
# Namely, the NEEDs and WANTs are followed recursively
# starting at the SOURCE and added to a whitelist that
# bypasses the regular RELATIVE / ABSOLUTE restrictions.
# This whitelist can be disabled with ALLOW_DEPS => 0.
# You can also require that all file access be declared
# with such a dependency header with CHECK_DEPS => 1,
# in case that helps keeping your templates up-to-date.
#
# By default, any symbolic prefix is permitted, though
# only the standard \${a}, \${B}/\${b}, \${B}/\${c} are
# tried for composing diagnostic messages.  To impose
# an explicit whitelist of symbolic prefixes, specify
# ALLOW_PREFIXES => [qw( \${a} \${B}/\${b} \${B}/\${c}
# \${custom} ... )].  To have more prefixes considered
# for diagnostic messages, pass PREFIXES => [qw( \${a}
# \${B}/\${b} \${B}/\${c} \${custom} ... )].  In both cases
# it is possible to opt out of any standard ones by
# omitting them from the explicit list.
#
# More options documented in the perldoc of
# $PROVIDER.
#
my \$provider = $PROVIDER->new({
	SOURCE => \$apath,
	DEFINITION => \$D,
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', \$D->{a} ],
})
	or die "[TT] ", $PROVIDER->error(), "\\n";
my \$tt = Template->new({ LOAD_TEMPLATES => [ \$provider ] })
	or die "[TT] ", \$Template::ERROR, "\\n";
NEW
			: <<"OLD",
my \$tt = Template->new({
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', @{[ $can_locale ? "to_fs(\$D->{a}, 'E')" : '$D->{a}' ]} ],
})
	or die "[TT] ", \$Template::ERROR, "\\n";
OLD
		BPATH_FS => $can_locale ? "to_fs(\$bpath, 'E')" : '$bpath',
		USE_GENLIB => $can_valoc
			? "use RdKw::WwW::GenLib $GENLIB_NEW qw( locate );"
			: 'use RdKw::WwW::GenLib qw( locate );',
		USE_TT_EXC => $can_valoc ? '' : <<\OLD,
use Template::Exception;
OLD
		LOCATE => $can_subst
			? <<\NEW
# relapath doesn't do well with the leading slash,
# though people may have a habit of including it...
(my $target = do {
	my ($name, $norm, $real);
	# Try symbolic prefix
	if (defined ($name = uproot('${a}',
		$norm = norm_dep($I{HAVE}))))
	{
		subs_dep($D, $name);
	}
	# Try literal prefix
	elsif (defined ($name = uproot($D->{a},
		$real = subs_dep($D, $norm))))
	{
		$name;
	}
	else {
		die "E: $apath: Your HAVE `$I{HAVE}'"
			. ($real eq $I{HAVE} ? "" : " (aka `$real')")
			. " is not under \${a} (aka `$D->{a}')\n";
	}
}) =~ s/\A\/+//;
NEW
			: <<\OLD,
(my $target = $I{HAVE}) =~ s{\A(?:\$(?:\{A\}|A)/)?(?:\$(?:\{a\}|a)|\Q$D->{a}\E)/}{}
	or $D->{a} eq '.' or die "E: $apath: HAVE `$I{HAVE}' not under \${a} ($D->{a})\n";
OLD
		V_LOCATE => $can_valoc
			? <<\NEW
	locate => sub { locate($O, $target, @_); },
NEW
			: <<\OLD,
	locate => sub {
		@_ == 1 or die Template::Exception->new(usage => "[% locate PATH %]");
		locate($O, $target, @_);
	},
OLD
	);
	$text =~ s/@(\w+)@/exists $sub{$1} ? $sub{$1} : die "$prog: $opt->{P}.render template: \@$1\@?\n"/ge;
	$text;
}
