#!perl
#
# t/redo.t - Makefile.in recipes as .do files

use strict;
use warnings;
use Test::More tests => 72;
# Pin LANGUAGE to C so gettext does not translate the messages matched below.
BEGIN { $ENV{LANGUAGE} = 'C' }
use RdKw::WwW::SiteConf::Backend::Redo;

my $class = 'RdKw::WwW::SiteConf::Backend::Redo';
# (the .do files by name; the default goal's is all.do, unless said)
sub files { my ($p, @d) = @_; my %f = map { ($_->[0], $_->[1]) } $class->emit($p, @d ? $d[0] : q(all.do)); \%f }
# A goal as -t selects it: of its own (-t goal), the default (-t ,goal, or
# -t , for the first), or both
sub own { { name => $_[0], select => $_[0], files => $_[1] || [] } }
sub dflt { { name => $_[0], default => $_[1], files => $_[2] || [] } }
sub both { { name => $_[0], default => ",$_[0]", select => $_[0], files => $_[1] || [] } }
# (a .do without its header)
sub body { (my $t = $_[0]) =~ s/\A(?:#.*\n)*//; $t }

my $plan = {
	prog => 'test', args => [], D => { e => '.ok' },
	goals => [ dflt(q(all), q(,), [q(x)]) ],
	order => ['x'], dirs => [ { dir => 'site', marker => 'site/.ok', deps => [] } ],
	node => { x => { bpath => 'site/x', deps => [ 'in/x', 'a b', '-o', 'site/.ok' ],
		recipe => [ [ text => "\t\@cd .. && cp in/x site/x\n\t-rm junk \$\$HOME\n\tsed 's:a:b:' \\\n\t\tq\n", 'x' ] ] } },
};
# (where the .do is, as $0 says: the build directory, if it is there)
my $B0 = 'case $0 in -*/*) d=./${0%/*}/ ;; */*) d=${0%/*}/ ;; *) d= ;; esac';
my $f = files($plan);
is_deeply([ sort keys %$f ], [ 'all.do', 'site/x.do' ], 'a .do for the target, and all.do for the default goal');
my $do = $f->{'site/x.do'};
like($do, qr/\A#!\/bin\/sh\n/, '#! first, for a redo that runs it by execve');
like($do, qr/^# \(generated by `test' :D\)$/m, 'header');
ok(!grep({ !$_->[2] } $class->emit($plan, q(all.do))), '... and every .do is to be executable');
like($do, qr/^set -e\n/m, 'stops at a failure');
like($do, qr/^case \$3 in \/\*\) o=\$3 ;; \*\) o=\$PWD\/\$3 ;; esac\n\Q$B0\E\nd=\$d\.\.\/\nexec >&2\n/m,
	'keeps $3, and finds the build directory from where the .do is');
like($do, qr/^redo-ifchange "\$d"in\/x "\$d"'a b' "\$d"\.\/-o\ncd -- "\$\{d:-\.\}"\n/m,
	'needs what it needs (quoted), but not the marker; then goes to the build directory');
like($do, qr/^\( cd \.\. && cp in\/x site\/x \)$/m, 'a command of its own, @ dropped');
like($do, qr/^\( rm junk \$HOME \) \|\| true$/m, '- ignores failure; $$ is $');
like($do, qr/^\( sed 's:a:b:' \tq \)$/m, 'a backslash joins lines');
like($do, qr/\nmv -f -- site\/x "\$o"\n\z/, 'the target is moved to $3');
is($f->{'all.do'} =~ /\n(set -e\ncase .*\nexec >&2\nredo-ifchange .*\n)\z/ && $1, "set -e\n$B0\nexec >&2\nredo-ifchange \"\$d\"site/x\n",
	'the goal needs its files, from the build directory');

{
	local $plan->{goals} = [ both(q(site), [q(x)]), own(q(demo/index)) ];
	my $f = files($plan);
	is_deeply([ sort keys %$f ], [ qw( all.do demo/index.do site.do site/x.do ) ],
		q(-t ,site,site -t demo/index: each goal of its own is its name (here that of a directory), and the default all));
	is(body($f->{q(all.do)}), body($f->{q(site.do)}), q(... the same but for the header));
	like($f->{q(demo/index.do)}, qr/^d=\$d\.\.\/\nexec >&2\n\z/m, q(a goal in a directory finds the build directory above it));
	local $plan->{goals} = [ dflt(q(main), q(,main), [q(x)]) ];
	is_deeply([ sort keys %{ files($plan) } ], [ qw( all.do site/x.do ) ], q(-t ,main: all.do, and no main.do));
	local $plan->{goals} = [ own(q(all), [q(x)]) ];
	is_deeply([ sort keys %{ files($plan) } ], [ qw( all.do site/x.do ) ], q(-t all: a goal of its own may be all, with no default));
	is_deeply([ sort keys %{ files($plan, undef) } ], [ qw( all.do site/x.do ) ], q(... whatever -o says));
	for my $bad ([ q(site/x), q(a target) ], [ q(in/x), q(a source) ]) {
		local $plan->{goals} = [ own($bad->[0], [q(x)]) ];
		ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name goal `\Q$bad->[0]\E': a file has that name/,
			qq(a goal cannot have the name of $bad->[1]));
	}
	local $plan->{goals} = [ dflt(q(main), q(,), [q(x)]), own(q(all), [q(x)]) ];
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name goal `all': all\.do is the default/,
		q(... or be all, if there is a default goal));
	local $plan->{goals} = [ own(q(../up), [q(x)]) ];
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name `\.\.\/up': it is not in the build directory/,
		q(... or be out of the build directory));
}
{
	# A target's .do is the same whatever goals are asked for, and a
	# goal's whatever other goals are
	local $plan->{args} = [ qw( -A ), q(-t), q(,main), qw( -t main -t WANT:small -Sx=y -Sflag ) ];
	local $plan->{goals} = [ both(q(main), [q(x)]), { name => q(small), select => q(WANT:small), files => [] } ];
	my $f = files($plan);
	like($f->{q(site/x.do)}, qr/^# options: -A -Sx=y -Sflag$/m, q(a target leaves out -t));
	like($f->{q(main.do)}, qr/^# options: -A -t main -Sx=y -Sflag$/m, q(a goal says itself));
	like($f->{q(all.do)}, qr/^# options: -A -t ,main -Sx=y -Sflag$/m, q(... and the default, as the default));
	like($f->{q(small.do)}, qr/^# options: -A -t WANT:small -Sx=y -Sflag$/m, q(... WANT: and all));
	local $plan->{args} = [];
	like(files($plan)->{q(small.do)}, qr/^# options: -t WANT:small$/m, q(... even if no -t was given));
}
{
	# -o: the default goal's .do, instead of all.do; /dev/null (undef), none
	local $plan->{goals} = [ dflt(q(main), q(,), [q(x)]), own(q(all)) ];
	is_deeply([ sort keys %{ files($plan, q(default.do)) } ], [ qw( all.do default.do site/x.do ) ],
		q(-o default.do: the default goal is default.do (and another may be all)));
	is_deeply([ sort keys %{ files($plan, undef) } ], [ qw( all.do site/x.do ) ],
		q(-o /dev/null: no .do for the default goal));
	ok(!eval { files($plan, q(default)); 1 } && $@ =~ /redo cannot find `default': the name of a \.do file ends in \.do/,
		q(-o without .do: redo would not find it));
	ok(eval { files($plan, q(site.do)); 1 }, q(-o site.do: a directory is all right)) or diag $@;
	ok(!eval { files($plan, q(in/x.do)); 1 } && $@ =~ /redo cannot name the default goal `in\/x\.do': a file has that name/,
		q(-o in/x.do: a file is not));
	ok(!eval { files($plan, q(all.do)); 1 } && $@ =~ /redo cannot name goal `all': all\.do is the default goal/,
		q(... and no other goal may be it));
}
{
	local $plan->{node}{x}{bpath} = '../out/x';
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name `\.\.\/out\/x': it is not in the build directory/,
		'a target out of the build directory');
}
{
	local $plan->{node}{x}{recipe} = [];
	ok(!eval { files($plan); 1 } && $@ =~ /no recipe/, 'no recipe, no .do');
}

{
	# A name is typed and is a file name: the same bytes, or an error
	require RdKw::I18N::CodeSets;
	local $plan->{node}{x}{bpath} = "site/r\x{e9}sum\x{e9}.html";
	local $RdKw::I18N::CodeSets::LOCALE =
		RdKw::I18N::CodeSets->locale->new(filesys => q(UTF-8), argv => q(UTF-8));
	ok(eval { files($plan); 1 }, q(UTF-8 for both: as it is)) or diag $@;
	$RdKw::I18N::CodeSets::LOCALE =
		RdKw::I18N::CodeSets->locale->new(filesys => q(UTF-8), argv => q(ISO-8859-1));
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name .*: arguments and file names spell it differently/,
		q(UTF-8 file names, Latin-1 arguments: an error)) or diag $@;
	$RdKw::I18N::CodeSets::LOCALE =
		RdKw::I18N::CodeSets->locale->new(filesys => q(UTF-8), argv => q(ascii));
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name .*: arguments cannot spell it/,
		q(UTF-8 file names, ASCII arguments: an error, for a name that is not ASCII)) or diag $@;
	local $plan->{node}{x}{bpath} = q(site/resume.html);
	ok(eval { files($plan); 1 }, q(... but not for one that is)) or diag $@;
}

{
	# -Sarg_prefix: the names of the shell variables
	local $plan->{opt} = { arg_prefix => q(sc_) };
	my $do = files($plan)->{q(site/x.do)};
	like($do, qr/^case \$3 in \/\*\) sc_o=\$3 ;; .*\ncase \$0 in -\*\/\*\) sc_d=\.\/.*\nsc_d=\$sc_d\.\.\/\n/m, q(-Sarg_prefix=sc_: $sc_o and $sc_d));
	like($do, qr/^redo-ifchange "\$sc_d"in\/x .*\ncd -- "\$\{sc_d:-\.\}"\n/m, q(... where it needs and goes));
	like($do, qr/\nmv -f -- site\/x "\$sc_o"\n\z/, q(... and where it moves the target));
	for my $none (undef, q()) {
		$plan->{opt} = { arg_prefix => $none };
		is(files($plan)->{q(site/x.do)}, $f->{q(site/x.do)}, q(-Sarg_prefix) . (defined $none ? q(=) : q()) . q(: no prefix));
	}
	for my $bad (q(1x), q(a-b), q(a b)) {
		$plan->{opt} = { arg_prefix => $bad };
		ok(!eval { files($plan); 1 } && $@ =~ /-Sarg_prefix=\Q$bad\E: a prefix is a letter/, qq(-Sarg_prefix=$bad: an error));
	}
}
{
	# -Sclean, -Spurge: name.do removes the files, from the build directory
	local $plan->{clean} = [ { name => q(clean), files => [ q(site/x), q(-y), q(a b) ] },
		{ name => q(demo/purge), files => [ q(site/x) ] } ];
	my $f = files($plan);
	is_deeply([ sort keys %$f ], [ qw( all.do clean.do demo/purge.do site/x.do ) ], q(a .do for each cleaning rule));
	is(body($f->{q(clean.do)}), "set -e\n$B0\nexec >&2\ncd -- \"\${d:-.}\"\nrm -f -- site/x ./-y 'a b'\n",
		q(... which goes to the build directory and removes the files));
	like($f->{q(demo/purge.do)}, qr/^d=\$d\.\.\/\nexec >&2\ncd -- "\$\{d:-\.\}"\nrm -f -- site\/x\n\z/m, q(... from a directory too));
	local $plan->{opt} = { arg_max => 11 };
	like(files($plan)->{q(clean.do)}, qr/^rm -f -- site\/x \.\/-y\nrm -f -- 'a b'\n\z/m, q(-Sarg_max=11: lines of no more than 11 bytes of names));
	$plan->{opt} = { arg_max => 0 };
	like(files($plan)->{q(clean.do)}, qr/^rm -f -- site\/x \.\/-y 'a b'\n\z/m, q(-Sarg_max=0: one line));
	$plan->{opt} = { arg_max => q(lots) };
	ok(!eval { files($plan); 1 } && $@ =~ /-Sarg_max=lots: expected a number of bytes, or auto/, q(-Sarg_max=lots: an error));
	$plan->{opt} = {};
	for my $bad ([ q(all), qr/redo cannot name cleaning rule `all': all\.do is the default goal's/, q(the default goal's .do) ],
			[ q(in/x), qr/redo cannot name cleaning rule `in\/x': a file has that name/, q(a source) ],
			[ q(../up), qr/redo cannot name `\.\.\/up': it is not in the build directory/, q(out of the build directory) ]) {
		local $plan->{clean} = [ { name => $bad->[0], files => [] } ];
		ok(!eval { files($plan); 1 } && $@ =~ $bad->[1], qq(a cleaning rule cannot be $bad->[2])) or diag $@;
	}
	for my $name (q(default), q(default.html), q(demo/default)) {
		local $plan->{clean} = [ { name => $name, files => [] } ];
		ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name cleaning rule `\Q$name\E': redo would run its \.do for other names/,
			qq(... or $name, which redo runs for other names)) or diag $@;
	}
	local $plan->{clean} = [ { name => q(defaults), files => [] } ];
	ok(eval { files($plan); 1 }, q(... but defaults is all right)) or diag $@;
	{
		# The options of cleaning are said only in the cleaning .do
		local $plan->{args} = [ qw( -t all -Sclean -Spurge=p -Sarg_max=40 -Sarg_prefix= ) ];
		my $g = files($plan);
		$plan->{args} = [ qw( -t all -Sarg_prefix= ) ];
		my $h = files($plan);
		is($g->{q(site/x.do)}, $h->{q(site/x.do)}, q(a target's .do is the same with -Sclean -Spurge -Sarg_max));
		is($g->{q(all.do)}, $h->{q(all.do)}, q(... and a goal's));
		like($g->{q(defaults.do)}, qr/^# options: -Sclean -Spurge=p -Sarg_max=40 -Sarg_prefix=$/m, q(... but the cleaning .do says them));
	}
	local $plan->{clean} = [ { name => q(top), files => [] } ];
	ok(!eval { files($plan, q(top.do)); 1 } && $@ =~ /redo cannot name cleaning rule `top': top\.do is the default goal's/,
		q(... as -o names it));
}
{
	# A .do is not written over a file: goal x, and target x.do
	local $plan->{node}{x}{bpath} = q(main.do);
	local $plan->{goals} = [ own(q(main), [q(x)]) ];
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot write `main\.do': another file has that name/,
		q(a .do is not written over a target)) or diag $@;
}

is_deeply([ sort $class->options ], [ qw( arg_max arg_prefix clean purge ) ], q(options));

is_deeply([ $class->build_command('redo', 'build', undef, 'all') ], [ qw[ ( cd build && redo all ) ] ], q(to build: cd to B, then redo the goal));
is_deeply([ $class->build_command(q(redo), q(.), undef, q(a b)) ], [ q(redo), "'a b'" ], q(... quoted, in B already));
is_deeply([ $class->build_command('redo', 'build', undef, undef) ], [ qw[ ( cd build && redo ) ] ], q(... or no goal));
{
	my $p = { goals => [ dflt(q(main), q(,)), own(q(other)) ], output => q(all.do) };
	is_deeply([ $class->build_command(q(redo), q(.), undef, q(main), $p) ], [ qw( redo all ) ], q(... the default goal, by its alias));
	$p->{output} = q(top.do);
	is_deeply([ $class->build_command(q(redo), q(.), undef, q(main), $p) ], [ qw( redo top ) ], q(... as -o says));
	$p->{output} = undef;
	is_deeply([ $class->build_command(q(redo), q(.), undef, q(main), $p) ], [ qw( redo other ) ],
		q(... or with none (-o /dev/null), the first goal of its own));
}
