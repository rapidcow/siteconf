#: ../siteconf/script/siteconf:310 ../siteconf/share/configure.in:182
#: ../siteconf/share/presets/tem.render:63
#: ../siteconf/share/presets/web.render:71
#, perl-format
msgid "usage: %s"
msgstr "用法：%s"

#: ../siteconf/script/siteconf:361 ../siteconf/share/configure.in:197
#: ../siteconf/share/presets/tem.render:60
#: ../siteconf/share/presets/web.render:68
msgid "too late to -C now."
msgstr "现在给 -C 已经太晚了。"

#: ../siteconf/script/siteconf:394
#, perl-format
msgid "conflicting modes: %s and %s"
msgstr "模式冲突：%s 和 %s"

#: ../siteconf/script/siteconf:398 ../siteconf/share/configure.in:199
msgid "too many arguments"
msgstr "参数太多"

#: ../siteconf/script/siteconf:406
msgid "named outputs are only for init"
msgstr "命名的输出只适用于 init"

#: ../siteconf/script/siteconf:408
msgid "unknown output name: %q"
msgstr "未知的输出名：%q"

#: ../siteconf/script/siteconf:410
msgid "empty output path"
msgstr "输出路径为空"

#: ../siteconf/script/siteconf:419
#, perl-format
msgid "%s is not permitted in mode %s"
msgstr "%s 不能用于模式 %s"

#: ../siteconf/script/siteconf:487
msgid "%#q: not a valid ASCII octal code point"
msgstr "%s：%s 不是有效的 ASCII 八进制码位"

#: ../siteconf/script/siteconf:501
msgid "%q: expected NEED or WANT, not %q"
msgstr "%s：应为 NEED 或 WANT，而不是 %q"

#. HEY!  the %s is the separator, as the option that
#. says it: -0 for a NUL, -012 for a newline
#: ../siteconf/script/siteconf:510
msgid "%q: %q conflicts with record separator %s"
msgstr "%q：%q 中有记录分隔符（%s）"

#: ../siteconf/script/siteconf:513 ../siteconf/script/siteconf:520
msgid "cannot write to stdout: %m"
msgstr "无法写入标准输出：%m"

#: ../siteconf/script/siteconf:531
msgid "cannot find %q (is WwW-SiteConf installed?)"
msgstr "找不到 %q（WwW-SiteConf 安装了吗？）"

#: ../siteconf/script/siteconf:540 ../siteconf/lib/RdKw/WwW/SiteConf.pm:846
msgid "cannot open file %q: %m"
msgstr "无法打开文件 %q：%m"

#: ../siteconf/script/siteconf:542
msgid "cannot read file %q: %m"
msgstr "无法读取文件 %q：%m"

#: ../siteconf/script/siteconf:596
msgid "Host-relative base URL"
msgstr "相对于主机的基础 URL"

#: ../siteconf/script/siteconf:597
msgid "Absolute base URL"
msgstr "绝对基础 URL"

#. HEY!  %s is the option (-Sx), and then what it may be
#: ../siteconf/script/siteconf:601
#, perl-format
msgid "%s: no such thing (valid: %s)"
msgstr "%s：没有这一项（有效的有：%s）"

#. HEY!  %s is an option, as -Sa (and likewise in the next few)
#: ../siteconf/script/siteconf:605 ../siteconf/script/siteconf:625
#, perl-format
msgid "%s may not be empty."
msgstr "%s 不能为空。"

#: ../siteconf/script/siteconf:608 ../siteconf/script/siteconf:612
#, perl-format
msgid "%s must be a relative path."
msgstr "%s 必须是相对路径。"

#: ../siteconf/script/siteconf:617
#, perl-format
msgid "%s and %s are the same thing; pick one."
msgstr "%s 和 %s 是同一回事；请选一个。"

#: ../siteconf/script/siteconf:631
msgid "bad preset name: %q"
msgstr "预设名有误：%q"

#: ../siteconf/script/siteconf:633
msgid "no such preset: %q"
msgstr "没有这个预设：%q"

#. HEY!  %s is the option, as -MModule=version (here and
#. in the next four)
#: ../siteconf/script/siteconf:652
#, perl-format
msgid "%s: bad module name"
msgstr "%s：模块名有误"

#: ../siteconf/script/siteconf:654
#, perl-format
msgid "%s: no version for what is dropped"
msgstr "%s：去掉的模块不能带版本"

#: ../siteconf/script/siteconf:657
#, perl-format
msgid "%s: bad version"
msgstr "%s：版本有误"

#: ../siteconf/script/siteconf:660
#, perl-format
msgid "%s: configure always needs it"
msgstr "%s：configure 总是需要它"

#: ../siteconf/script/siteconf:664
#, perl-format
msgid "%s: version %s or later is required"
msgstr "%s：需要版本 %s 或更高版本"

#: ../siteconf/script/siteconf:681
msgid "preset does not supply a render output"
msgstr "该预设不提供 render 输出"

#: ../siteconf/script/siteconf:687
msgid "dangerous name for render: %q is not supported (yet)"
msgstr "render 的名字很危险：（暂时）不支持 %q"

#: ../siteconf/script/siteconf:730
msgid "Not changing %#q"
msgstr "不更改 %#q"

#: ../siteconf/script/siteconf:736
msgid "cannot remove %q: %m"
msgstr "无法删除 %q：%m"

#: ../siteconf/script/siteconf:749
msgid "cannot create file %q: %m"
msgstr "无法创建文件 %q：%m"

#: ../siteconf/script/siteconf:752 ../siteconf/script/siteconf:754
msgid "cannot write file %q: %m"
msgstr "无法写入文件 %q：%m"

#: ../siteconf/script/siteconf:757
msgid "cannot chmod %q: %m"
msgstr "无法修改 %q 的权限：%m"

#: ../siteconf/script/siteconf:767
msgid "Overwrote %#q"
msgstr "已覆盖 %#q"

#: ../siteconf/script/siteconf:767
msgid "Wrote %#q"
msgstr "已写入 %#q"

#: ../siteconf/script/siteconf:772
msgid "You already have configure."
msgstr "你已经有 configure 了。"

#: ../siteconf/script/siteconf:773
msgid "You already have configure at %q."
msgstr "你已经在 %q 有 configure 了。"

#: ../siteconf/script/siteconf:775
msgid ""
"Pass -o /dev/null if you did mean to not generate configure,\n"
"or -f to overwrite the existing one."
msgstr ""
"如果你确实不想生成 configure，请传 -o /dev/null；\n"
"要覆盖现有的，请传 -f。"

#. HEY!  %#q is the file name of the faulty
#. file and %d is its lineno.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:300
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:102
msgid "%#q line %d"
msgstr "%#q 行 %d"

#. HEY!  Keep a winky face in the translation ;)
#. (as GenGenLib's load_state does: newbies see it)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:366
msgid ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"
msgstr ""
"你还没有配置！（没有 %q）\n"
"请先运行 ./configure。(⸝⸝> ᴗ•⸝⸝)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:383
msgid "%q: %q is missing.  Try reconfiguring."
msgstr "%q：缺少 %q。请尝试重新配置。"

#. HEY!  %q is a variable of config.mk: `b' or `c', which are where
#. what we make goes (the target tree, and the cache)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:389
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:394 ../siteconf/share/configure.in:297
#: ../siteconf/share/configure.in:309
msgid "%q prefix must be a relative path."
msgstr "%q 前缀必须是相对路径。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:397
msgid "%q prefix may not climb out of the build directory."
msgstr "%q 前缀不能跑出构建目录。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:400
msgid "%q (directory marker) may not contain a slash."
msgstr "%q（目录标记）不能含有斜杠。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:403
msgid "%q may be made of letters, digits and -_.+& only: %q"
msgstr "%q 只能由字母、数字和 -_.+& 组成：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:411
msgid "cannot find the build directory %q: %m"
msgstr "找不到构建目录 %q：%m"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:414
msgid "cannot find the source tree %q: %m"
msgstr "找不到源代码树 %q：%m"

#. HEY!  The first %s is where (a file, or `file' line 3), and
#. the second is b or c (a variable of config.mk, as in ${b}).
#. Leave the ${...}s alone: they are what is written in a header.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:480
#, perl-brace-format
msgid "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."
msgstr "%1$s：%2$q：${%3$s} 是相对于 ${B} 的；请写 ${B}/${%3$s}。"

#. HEY!  the last %s is what is in a header, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:499
msgid "%s: %q: %s is no code point"
msgstr "%s：%q：%s 不是码位"

#. HEY!  the last %s is the variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:506
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:258
msgid "%s: %q: no such variable %s"
msgstr "%s：%q：没有变量 %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:510
msgid "%s: stray $ in %q"
msgstr "%s：%q 中有多余的 $"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:515
#, perl-format
msgid "%s: empty path"
msgstr "%s：路径为空"

#. HEY!  The first %s is always where (a file, or `file' line 3),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:606
msgid "%s: bad file name %q"
msgstr "%s：文件名有误：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:609
msgid "%s: file name %q must be relative"
msgstr "%s：文件名 %q 必须是相对的"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:612
msgid "%s: file name %q is out of tree"
msgstr "%s：文件名 %q 在树外"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:664
msgid "%s: %q is a reserved goal name"
msgstr "%s：%q 是保留的目标名"

#. HEY!  the second %s is what is in Makefile.in, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:719
#, perl-format
msgid "%s: %s is not a valid Unicode code point"
msgstr "%s：%s 不是有效的 Unicode 码位"

#. HEY!  the second %s is a variable, as ${@} (or ${.TARGET}),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:726
#, perl-format
msgid "%s: %s outside of a recipe"
msgstr "%s：%s 出现在配方之外"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:731
#, perl-format
msgid "%s: misplaced %s (not in a recipe)"
msgstr "%s：%s 放错了地方（不在配方中）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:734
#, perl-format, perl-brace-format
msgid "%s: undefined %s (explicitly suppressed by ${a})"
msgstr "%s：%s 未定义（被 ${a} 显式取消了）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:741
#, perl-format
msgid "%s: undefined variable: %s"
msgstr "%s：未定义的变量：%s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:813
#, perl-brace-format
msgid "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"
msgstr "%s：%q：目标前面没有合法的前缀（${b} 或 ${c}）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:863
#, perl-format
msgid "%s: unfinished line continuation"
msgstr "%s：续行没有结束"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:875
msgid "%s: more than one recipe for %q"
msgstr "%s：%q 有不止一个配方"

#. HEY!  a recipe line (one that begins with a tab)
#. with no rule above it to be the recipe of
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:887
#, perl-format
msgid "%s: unexpected tabulation"
msgstr "%s：意外的制表符"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:899
#, perl-format
msgid "%s: null target list"
msgstr "%s：目标列表为空"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:917
#, perl-brace-format
msgid "%s: %q must be one name in ${a}"
msgstr "%s：%q 必须是 ${a} 中的一个名字"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:934
msgid ""
"%s: %q: a prerequisite must start with either `NEED:' or `WANT:', not %q"
msgstr "%s：%q：先决条件必须以 `NEED:' 或 `WANT:' 开头，而不是 %q"

#. HEY!  %q is `NEED:' or `WANT:', literally.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:939
msgid "%s: %q something?"
msgstr "%s：%q 什么呢？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:950
msgid "%s: invalid line: %q"
msgstr "%s：无效的行：%q"

#. HEY!  %s is the files, as `a' -> `b' -> `a'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:982
#, perl-format
msgid "dependency cycle: %s"
msgstr "依赖循环：%s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:998
msgid "%q: %q is reserved for directory markers. (Set -De to change it.)"
msgstr "%q：%q 是保留给目录标记的。（要改的话请设置 -De。）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1019
msgid "no rule to make it (%q)"
msgstr "没有生成它的规则（%q）"

#. HEY!  the %s is where the rule is (e.g. `file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1025
msgid "source %q is missing (rule at %s)"
msgstr "缺少源文件 %q（规则在 %s）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1026
msgid "source %q is missing"
msgstr "缺少源文件 %q"

#. HEY!  Keep the question mark: we are as puzzled as
#. anyone.  The (aka %q) is what the HAVE says, expanded
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1041
msgid ""
"%q: You HAVE %q (aka %q),\n"
"but I need %q?"
msgstr ""
"%q：你 HAVE %q（又名 %q），\n"
"但我需要的是 %q？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1043
msgid ""
"%q: You HAVE %q,\n"
"but I need %q?"
msgstr ""
"%q：你 HAVE %q，\n"
"但我需要的是 %q？"

#. HEY!  This and the next three are where a NEED (or a WANT)
#. was said, and are said in parentheses after what is needed
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1050
msgid "in header"
msgstr "在头部中"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1050
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1232
msgid "in header of %q"
msgstr "在 %q 的头部中"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1054
#, perl-format
msgid "prerequisite in %s"
msgstr "%s 中的先决条件"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1055
#, perl-format
msgid "WANT: in %s"
msgstr "%s 中的 WANT:"

#. HEY!  %s is where it was needed (in header of `file').
#. The same goes for the next two marked strings.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1113
msgid "NEEDs %q (%s), but cannot be made:"
msgstr "NEED %q（%s），但它无法生成："

#. HEY!  The last %q is the name it may have meant: a
#. header says MY/option.mk, when it is ${B}/MY/option.mk
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1125
msgid "NEEDs %q (%s), which we don't seem to have (is it %q?)"
msgstr "NEED %q（%s），但我们似乎没有它（是 %q 吗？）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1127
msgid "NEEDs %q (%s), which we don't seem to have"
msgstr "NEED %q（%s），但我们似乎没有它"

#. HEY!  The %s, in parentheses, is where it
#. was wanted (in header of `file').  The face
#. is yours to keep; i added it because "W"
#. felt like a weak indication of a soft dep
#. failing....
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1143
msgid ""
"target %q WANTs %q\n"
"  (%s)\n"
"... but it is missing; going on without it :("
msgstr ""
"目标 %q WANT %q\n"
"  （%s）\n"
"但它不存在，只好没有它继续下去... ( ˶•ᴖ•)"

#. HEY!  As above, for a tool of the rule; the last %s
#. is where the rule is (`file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1224
msgid ""
"%q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%1$q：你 HAVE %2$q（又名 %3$q），\n"
"但 %5$q 的规则（%6$s）需要的是 %4$q？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1227
msgid ""
"%q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%1$q：你 HAVE %2$q，\n"
"但 %4$q 的规则（%5$s）需要的是 %3$q？"

#. HEY!  the %s is where (`file' line 3); what
#. follows the colon is why, a line each
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1293
msgid "%s: goal %q NEEDs %q, but cannot be made:"
msgstr "%s：目标 %q NEED %q，但它无法生成："

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1298
msgid "goal %q WANTs %q, but cannot be made:"
msgstr "目标 %q WANT %q，但它无法生成："

#. HEY!  "no soup for you!" (Seinfeld) but with Makefile
#. (not my bit, Claude came up with this... but cool
#. nonetheless o_o)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1314
#, perl-format
msgid "%d problem; no Makefile for you."
msgid_plural "%d problems; no Makefile for you."
msgstr[0] "%d 个问题；不给你 Makefile。"

#. HEY!  %s is the option, as in -Dclean=clean-&
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1384
msgid "%s: %q is also the name of a goal or another rule"
msgstr "%s：%q 也是某个目标或另一条规则的名字"

#. HEY!  %s is the generators (make, gmake, ninja)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1442
msgid "unknown generator %q.  Choose one of: %s"
msgstr "未知的生成器 %q。请从这些中选一个：%s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1448
msgid "bad output name %q: stay in the build directory please"
msgstr "输出名 %q 有误：请留在构建目录里"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1470
msgid "Removing %q"
msgstr "正在删除 %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1488 ../siteconf/share/configure.in:330
msgid "Done!"
msgstr "完成！"

#. HEY!  %s is a command line, as the shell would read it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1490
#, perl-format
msgid "To build, run: %s"
msgstr "要构建，请运行：%s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1507 ../siteconf/share/configure.in:319
msgid "Writing %#q"
msgstr "正在写入 %#q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1508 ../siteconf/share/configure.in:319
msgid "Updating %#q"
msgstr "正在更新 %#q"

#. HEY!  the %s is a character, as `;' or U+000A
#: ../siteconf/lib/RdKw/WwW/SiteConf/GMake.pm:44
#, fuzzy
msgid "GNU Make cannot name %q (with inescapable %s)"
msgstr "GNU make 无法表示 %q（其中有 %s）"

#. HEY!  lib(member.o) is how make names a member of an archive
#: ../siteconf/lib/RdKw/WwW/SiteConf/GMake.pm:48
#, fuzzy
msgid "GNU Make cannot name %q (reserved for archive members)"
msgstr "GNU make 无法表示 %q（它会被当成归档成员）"

#. HEY!  the %s is a character, as `$' or U+0020.
#. You don't need to keep the ";)"; it's just
#. reflexive for me as a tone indicator... :x
#: ../siteconf/lib/RdKw/WwW/SiteConf/Make.pm:97
#, fuzzy
msgid ""
"make cannot name %q (with inescapable %s),\n"
"... but GNU Make can!  (Pass -G gmake if you want that. ;)"
msgstr "make 无法表示 %q（其中有 %s）；GNU make 可以（-G gmake）"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Make.pm:99
#, fuzzy
msgid "make cannot name %q (with inescapable %s)"
msgstr "make 无法表示 %q（其中有 %s）"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:110
msgid "unterminated %q"
msgstr "%q 没有结束"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:161
#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:227
msgid "unterminated :S modifier"
msgstr ":S 修饰符没有结束"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:218
#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:259
msgid "empty modifier"
msgstr "修饰符为空"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:229
msgid "bad delimiter %q for :S"
msgstr ":S 的分隔符 %q 有误"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:236
msgid "unknown flag %q for :S"
msgstr ":S 的未知标志 %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:251
#: ../siteconf/lib/RdKw/WwW/SiteConf/Modifiers.pm:256
msgid "unknown modifier %q"
msgstr "未知的修饰符 %q"

