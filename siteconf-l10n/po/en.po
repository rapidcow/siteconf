msgid "%#q line %d"
msgstr "%#q line %d"

#. HEY!  Keep a winky face in the translation ;)
#. (as GenGenLib's load_state does: newbies see it)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:509
msgid ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"
msgstr ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:526
msgid "%q: %q is missing.  Try reconfiguring."
msgstr "%q: %q is missing.  Try reconfiguring."

#. HEY!  %q is a variable of config.mk: `b' or `c', which are where
#. what we make goes (the target tree, and the cache)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:532
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:537
msgid "%q prefix must be a relative path."
msgstr "%q prefix must be a relative path."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:540
msgid "%q prefix may not climb out of the build directory."
msgstr "%q prefix may not climb out of the build directory."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:543
msgid "%q (directory marker) may not contain a slash."
msgstr "%q (directory marker) may not contain a slash."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:550
msgid "cannot find the build directory %q: %m"
msgstr "cannot find the build directory %q: %m"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:553
msgid "cannot find the source tree %q: %m"
msgstr "cannot find the source tree %q: %m"

#. HEY!  The first %s is where (a file, or `file' line 3), and
#. the second is b or c (a variable of config.mk, as in ${b}).
#. Leave the ${...}s alone: they are what is written in a header.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:660
#, perl-brace-format
msgid "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."
msgstr "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."

#. HEY!  the last %s is what is in a header, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:681
msgid "%s: %q: %s is no code point"
msgstr "%s: %q: %s is no code point"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:688
msgid "%s: %q: no such variable %s"
msgstr "%s: %q: no such variable %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:692
msgid "%s: stray $ in %q"
msgstr "%s: stray $ in %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:697
#, perl-format
msgid "%s: empty path"
msgstr "%s: empty path"

#. HEY!  The first %s is where (as in the messages above), %s
#. the character (U+0041) and %s its spelling in bytes (0x5C).
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:821
#, perl-format
msgid ""
"%s: %s is encoded as %s in file system encoding%s, which contains ASCII "
"metacharacters"
msgstr ""
"%s: %s is encoded as %s in file system encoding%s, which contains ASCII "
"metacharacters"

#. HEY!  The first %s is always where (a file, or `file' line 3),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:884
msgid "%s: bad file name %q"
msgstr "%s: bad file name %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:888
msgid "%s: file name %q must be relative"
msgstr "%s: file name %q must be relative"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:891
msgid "%s: file name %q is out of tree"
msgstr "%s: file name %q is out of tree"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:929
#, perl-format
msgid "%s: a name of a rule may not be empty"
msgstr "%s: a name of a rule may not be empty"

#. HEY!  the second %s is the name, as in -Sclean=a:b
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:933
msgid "%s: %q cannot be the name of a rule"
msgstr "%s: %q cannot be the name of a rule"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:962
msgid "%s: %q is a reserved goal name"
msgstr "%s: %q is a reserved goal name"

#. HEY!  the second %s is a chain of
#. goals which ends in the beginning
#. node; e.g. `a -> b -> a'.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:990
#, perl-format
msgid "%s: cyclic goal: %s"
msgstr "%s: cyclic goal: %s"

#. HEY!  the second %s is a string literal, as ${"..."}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1081
#, perl-format
msgid "%s: junk after the string in %s"
msgstr "%s: junk after the string in %s"

#. HEY!  the second %s is what is in Makefile.in, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1103
#, perl-format
msgid "%s: %s is not a valid Unicode code point"
msgstr "%s: %s is not a valid Unicode code point"

#. HEY!  the second %s is a variable, as ${@} (or ${.TARGET}),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1110
#, perl-format
msgid "%s: %s outside of a recipe"
msgstr "%s: %s outside of a recipe"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1115
#, perl-format
msgid "%s: misplaced %s (not in a recipe)"
msgstr "%s: misplaced %s (not in a recipe)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1118
#, perl-format, perl-brace-format
msgid "%s: undefined %s (explicitly suppressed by ${a})"
msgstr "%s: undefined %s (explicitly suppressed by ${a})"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1125
#, perl-format
msgid "%s: undefined variable: %s"
msgstr "%s: undefined variable: %s"

#. HEY!  the second %s is where, as `a prerequisite'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1137
#, perl-format
msgid ":Q (shell quote) is not valid in %s"
msgstr ":Q (shell quote) is not valid in %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1138
msgid "a name"
msgstr "a name"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1139
msgid ":Q (shell quote) must be the last modifier"
msgstr ":Q (shell quote) must be the last modifier"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1144
msgid "a nested expansion"
msgstr "a nested expansion"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1170
msgid "a prerequisite"
msgstr "a prerequisite"

#. HEY!  The first %s is where, the second what is in Makefile.in
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1174
msgid "%s: %q expands to nothing"
msgstr "%s: %q expands to nothing"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1203
#, perl-brace-format
msgid "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"
msgstr "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"

#. HEY!  the second %s is a variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1241
#, perl-format
msgid "%s: %s is already defined"
msgstr "%s: %s is already defined"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1257
msgid "a variable assignment"
msgstr "a variable assignment"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1308
#, perl-format
msgid "%s: unfinished line continuation"
msgstr "%s: unfinished line continuation"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1320
msgid "%s: more than one recipe for %q"
msgstr "%s: more than one recipe for %q"

#. HEY!  a recipe line (one that begins with a tab)
#. with no rule above it to be the recipe of
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1332
#, perl-format
msgid "%s: unexpected tabulation"
msgstr "%s: unexpected tabulation"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1349
#, perl-format
msgid "%s: null target list"
msgstr "%s: null target list"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1379
msgid ""
"%s: %q: a prerequisite must start with NEED:, WANT:, JUST: (or JUST-NEED:) "
"or JUST-WANT:, not %q"
msgstr ""
"%s: %q: a prerequisite must start with NEED:, WANT:, JUST: (or JUST-NEED:) "
"or JUST-WANT:, not %q"

#. HEY!  %q is `NEED:' or `WANT:', literally.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1384
msgid "%s: %q something?"
msgstr "%s: %q something?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1404
msgid "%s: invalid line: %q"
msgstr "%s: invalid line: %q"

#. HEY!  %s is the files, as `a' -> `b' -> `a'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1437
#, perl-format
msgid "dependency cycle: %s"
msgstr "dependency cycle: %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1463
msgid "%q: %q is reserved for directory markers. (Set -De to change it.)"
msgstr "%q: %q is reserved for directory markers. (Set -De to change it.)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1485
msgid "no rule to make it (%q)"
msgstr "no rule to make it (%q)"

#. HEY!  the %s is where the rule is (e.g. `file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1491
msgid "source %q is missing (rule at %s)"
msgstr "source %q is missing (rule at %s)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1492
msgid "source %q is missing"
msgstr "source %q is missing"

#. HEY!  Keep the question mark: we are as puzzled as
#. anyone.  The (aka %q) is what the HAVE says, expanded
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1507
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q?"
msgstr ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1509
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q?"
msgstr ""
"%#q: You HAVE %q,\n"
"but I need %q?"

#. HEY!  This and the next three are where a NEED (or a WANT)
#. was said, and are said in parentheses after what is needed
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1516
msgid "in header"
msgstr "in header"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1516
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1718
msgid "in header of %q"
msgstr "in header of %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1521
#, perl-format
msgid "prerequisite in %s"
msgstr "prerequisite in %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1522
#, perl-format
msgid "WANT: in %s"
msgstr "WANT: in %s"

#. HEY!  %s is where it was needed (in header of `file').
#. The same goes for the next two marked strings.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1588
msgid "NEEDs %q (%s), but cannot be made:"
msgstr "NEEDs %q (%s), but cannot be made:"

#. HEY!  The last %q is the name it may have meant: a
#. header says MY/option.mk, when it is ${B}/MY/option.mk
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1600
msgid "NEEDs %q (%s), which we don't seem to have (is it %q?)"
msgstr "NEEDs %q (%s), which we don't seem to have (is it %q?)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1602
msgid "NEEDs %q (%s), which we don't seem to have"
msgstr "NEEDs %q (%s), which we don't seem to have"

#. HEY!  The %s, in parentheses, is where it
#. was wanted (in header of `file').  The face
#. is yours to keep; i added it because "W"
#. felt like a weak indication of a soft dep
#. failing....
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1618
msgid ""
"target %q WANTs %q\n"
"  (%s)\n"
"... but it is missing; going on without it :("
msgstr ""
"target %q WANTs %q\n"
"  (%s)\n"
"... but it is missing; going on without it :("

#. HEY!  As above, for a tool of the rule; the last %s
#. is where the rule is (`file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1710
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1713
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%#q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"

#. HEY!  the %s is where (`file' line 3); what
#. follows the colon is why, a line each
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1809
msgid "%s: goal %q NEEDs %q, but cannot be made:"
msgstr "%s: goal %q NEEDs %q, but cannot be made:"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1814
msgid "goal %q WANTs %q, but cannot be made:"
msgstr "goal %q WANTs %q, but cannot be made:"

#. HEY!  "no soup for you!" (Seinfeld) but with Makefile
#. (not my bit, Claude came up with this... but cool
#. nonetheless o_o)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1841
#, perl-format
msgid "%d problem; no Makefile for you."
msgid_plural "%d problems; no Makefile for you."
msgstr[0] "%d problem; no Makefile for you."
msgstr[1] "%d problems; no Makefile for you."

#. HEY!  the first %s is a name that is of a goal (or a
#. cleaning rule), and the second the file (it may be spelled
#. in other bytes: the file system and the arguments can differ)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1885
msgid "%q is the name of a rule, and a file (%q) is as well"
msgstr "%q is the name of a rule, and a file (%q) is as well"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1915
msgid "%q: expected a goal name"
msgstr "%q: expected a goal name"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1916
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:256
msgid "%#q: missing goal %q"
msgstr "%#q: missing goal %q"

#. HEY!  %s is the option, as in -Sclean=clean-& (or -Sclean)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1966
msgid "%s: %q is also the name of a goal or another rule"
msgstr "%s: %q is also the name of a goal or another rule"

#. HEY!  %s is the generators (make, gmake, ninja)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2033
msgid "unknown generator %q.  Choose one of: %s"
msgstr "unknown generator %q.  Choose one of: %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2039
msgid "bad output name %q: stay in the build directory please"
msgstr "bad output name %q: stay in the build directory please"

#. HEY!  the first %s is an option, as -Sclean=x, and the second
#. the generator (make, gmake, ninja)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2057
#, perl-format
msgid "%s: unused by generator %s"
msgstr "%s: unused by generator %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2076
msgid "Removing %q"
msgstr "Removing %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2097 ../siteconf/share/configure.in:302
msgid "Done!"
msgstr "Done!"

#. HEY!  %s is a command line, as the shell would read it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2099
#, perl-format
msgid "To build, run: %s"
msgstr "To build, run: %s"

#. HEY!  ``Writing'' creates the file, and
#. ``Updating'' overwrites it.   (The phrasing
#. is different from what we call it over at
#. `siteconf -i', primarily because MY/MANIFEST
#. is considered to be our files, so it is
