#!/usr/bin/env perl
# HAVE: @PATH@
# NEED: ${B}/MY/option.mk
#
# (Note that we do not "NEED" MY/config.mk; doing so
# would declare an undesirable dependency edge that
# undermines the very point of separating these two.
#
# We do depend on it to be very clear; it's just that
# we don't need to re-render stuff when it changes.)
#
# @NAME@ - Template Toolkit renderer
#
# To invoke this, add to your Makefile.in (or whatever
# you set your "R" path to):
#
#    page.txt: @PATH@
#       cd -- $A && ${^X} @PATH_Q@ -B $B \
#          -- $a/${.IMPSRC} $B/$b/${.TARGET}
#
# (Multiple files are okay!)
#
# More information about Template Toolkit here:
# https://template-toolkit.org/
#
use 5.008;
use strict;
use warnings;

use Encode ();
use Encode::Locale ();
use PerlIO::encoding ();
use Getopt::Std;
use RdKw::WwW::GenGenLib 0.0100 qw( load_state to_fs );
use Template;
@USE_PROVIDER@
# What we say is as the locale says (\x{...} where it cannot).
# File names and arguments are characters, spelled as the
# locale says; what is in the files is UTF-8.
{
	local $PerlIO::encoding::fallback = Encode::PERLQQ();
	binmode STDOUT, ':encoding(console_out)';
	binmode STDERR, ':encoding(console_out)';
}

eval { Encode::Locale::decode_argv(Encode::FB_CROAK()); 1 }
	or die "$0: cannot read the arguments in this locale\n";
my %o;
getopts('B:', \%o) or die "usage: $0 [-B BUILDDIR] apath bpath\n";
my $B = defined $o{B} ? $o{B} : '.';
@ARGV == 2 or die "$0: need exactly two args\n";
my ($apath, $bpath) = @ARGV;

my %S = load_state($B);
my %v = (
	D => $S{config},
	O => $S{option},
);
my $D = $S{config};

#
# UTF-8 on both ends: ENCODING for what is read (the source,
# and what it INCLUDEs), binmode for what is written.
#
@TT_NEW@
$tt->process(@APATH_FS@, \%v, to_fs($bpath, 'E'),
	{ binmode => ':encoding(UTF-8)' })
	or die "[TT] ", $tt->error(), "\n";

exit;  # goodbye!
