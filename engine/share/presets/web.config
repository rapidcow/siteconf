
# The `web' preset: Template Toolkit static site generator.
#
# The render script requires Template and GenLib for locate.
# At configure-time, parse_base from GenLib is required for
# validating/initializing site_url and base_url.
#
# USE: RdKw::WwW::GenLib
# USE: Template
#
# These dependencies are hints for `siteconf -i'.  You may
# require a different version with `-MFoo=123', or remove it
# with `-MFoo=', and those will be the effective dependency
# of your configure script.
#
sub preset_finish
{
	my ($D, $O) = @_;
	isnull($O->{base_url}) and $O->{base_url} = '/';
	isnull($O->{site_url}) and die "E: missing `site_url' option\n";
	eval { RdKw::WwW::GenLib::parse_base($O); 1 } or do {
		(my $err = $@) =~ s/^/E: /mg;
		die $err;
	};
}
