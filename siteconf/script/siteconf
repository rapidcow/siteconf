#!perl

use 5.008;
use strict;
use warnings;

=head1 NAME

siteconf - configurable incremental build script generator

=head1 SYNOPSIS

    siteconf [-C codeset ...] [-q] [-i|-g|-l|-V] [<args>]

    siteconf -i [-P preset] [-o [name:]path ...] [-f]
             [-M[-]module[=version] ...] [-Sopt=val ...]
             [-Dvar=val ...] [-Ovar=val ...]
    siteconf init ...                         # same

    #
    # -S: where things are, baked into ./configure as defaults
    #
    # path to project root, seen from where ./configure is run
    #   -SA=.       (default)
    #   -SA=..      (alternatively if we live in a subdirectory
    # path to build dir, seen from the project root $A, or absolute
    #   -SB=.       (default)
    #   -SB=build   (CMake style)
    #   -SB=/tmp/writable/build/dir  (read-only checkout)
    # path to transformation rules, relative to where `siteconf -g' is run
    #   -SR=Makefile.in (default)
    # path to top-level manifest, likewise
    #   -SF=MANIFEST  (default)
    # path to source tree relative to $A
    #   -Sa=html    (default, since we originate from SSG.)
    #   -Sa=.       (a sane alternative)
    # path to output tree relative to $B
    #   -Sb=site    (default)
    # directory marker
    #   -Se=.ok     (default)
    #   -Se=.exists (mimics EU::MM)
    #
    # -D, -O: defaults for definitions and options (see ./configure -h)
    #
    # -P: preset, such as web or tem (the default is none)
    #

    ./configure [-DB=outdir] [-Db=reldir] [-Ovar=val ...]

    siteconf -g [-B outdir] [-G make|gmake|ninja] [-t [NEED:|WANT:]goal ...] [-q]
    siteconf make ...                         # same
    cd ${B} && [make|gmake|ninja] [goal]   # ninja -t clean to clean

    siteconf -l [-F manifest] [-t [goal][:NEED|:WANT] ...] [-0[octal]]
    siteconf list ...                         # same
    siteconf -l -0 -F ${B}/MY/MANIFEST.all |
        tar -c -f site.tar -C ${B}/${b} --null -T -

=head1 DESCRIPTION

C<siteconf -i> writes F<configure>.  F<configure> writes
F<${B}/MY/config.mk> (I<definitions>, which are only filesystem
routing) and F<${B}/MY/option.mk> (I<options>, which alter the
state of the build, and which whatever is transformed may depend on).

C<siteconf -g> reads those, along with the rules (F<Makefile.in>)
and the F<MANIFEST> they were pointed at (as seen from where you run
it: they are not part of the source tree), and writes the build file
in I<${B}>, and F<MY/MANIFEST.I<goal>> for each goal in the manifest.
See L<RdKw::WwW::SiteConf> for what those look like.

With the C<web> preset (C<-P web>), F<siteconf -i> also writes a plain
F<render> script next to the rules (in C<-SA>, which is the current directory
by default), unless one is already there (use C<-f> to overwrite).  F<configure> requires an
C<-Osite_url>, and sees to it that C<base_url> agrees.  The files
are rendered through Template Toolkit; by convention with the
namespaces C<D> and C<O>, the variable C<location>, and the function
C<locate>, though it is each F<render> that decides;
see L<RdKw::WwW::GenLib/SYNOPSIS>.

The C<tem> preset (C<-P tem>) is the same without the web: F<render>
gives a template C<D> and C<O>, and nothing else, and F<configure>
asks for no options (nor GenLib).

For the generated script, see L<RdKw::WwW::SiteConf::Configure>.

File names and arguments are read as L<RdKw::I18N::CodeSets> says:
as the locale says, but for what C<SITECONF_CODESETS> and then C<-C>
say (see L</ENVIRONMENT>).  Messages are written that way too (what cannot be
said there is written as C<\x{...}>).  An argument or a name that
cannot be spelled is an error.  What is in the files we read and write is always UTF-8.
(What C<-l> writes is no message, but names: see there.)

=head1 OPTIONS

=over

=item B<-C> I<codeset>

Read arguments and file names, and write messages, in these code sets,
after what C<SITECONF_CODESETS> says (see L</ENVIRONMENT>), whatever
else is done.  May be given more than once; a later one overrides what
came before.  It must come first, before anything else (C<-C0>, glued,
is fine; C<-iC0> is not): what comes after it is read as it says, and
after that, it is too late.  It is not written into F<configure>, which
takes C<-C> of its own.

=item B<-i>, B<init>

Write F<configure> (or whatever I<-o> says).

=item B<-M>[B<->]I<module>[=I<version>]

Have F<configure> check that I<module> can be loaded (and is at
least I<version>, if given) before doing anything else.  May be
given more than once; a later one for the same module replaces
the earlier.  F<configure> always checks for L<RdKw::I18N::CodeSets>
and L<RdKw::WwW::GenGenLib> (version 0.0100, which spells file names
as CodeSets says, and which F<render> needs; a later I<version> may
be asked for, but not an earlier one: neither F<configure> nor
F<render> is written for those),
and so does the preset for what it needs (C<# USE:>
lines in its config).  C<-M->I<module> drops I<module> from the list,
even one the preset asked for (as C<-M>I<module>C<=> does, with
nothing after the C<=>); a later C<-M>I<module> puts it back.

C<-MRdKw::WwW::GenGenLib::Template::Provider> (which nothing asks for,
and nothing needs) has F<render> load templates through it: what a page
C<INCLUDE>s (or C<PROCESS>es, C<WRAPPER>s, C<INSERT>s) must be declared
in its header, or in the header of what that declares, and so on; and
the names are spelled as CodeSets says.

=item B<-g>, B<make>

Write the build file, reading the configuration from C<-B>
(the current directory by default).

=item B<-B> I<dir>

The build directory, as seen from here.  Everything else is derived
from F<MY/config.mk> there, so it does not matter from where this is
run.

=item B<-G> I<generator>

C<make> (default), writing F<Makefile>; C<gmake>, writing one for GNU
make, which can name files that make cannot (with blanks, C<#>, C<:>,
C<$>, wildcards and so on: see L<RdKw::WwW::SiteConf::GMake>); or
C<ninja>, writing F<build.ninja>.  A name that the generator cannot
spell is an error.

=item B<-o> I<file>

With C<-g>, write I<file> in the build directory instead of F<Makefile>
(or F<build.ninja>); say C<make -f Makefile.proj> to use it.  Just a
name, not a path.

With C<-i>, may be repeated as C<-o name:path>, where I<name> is
C<configure> or C<render>.  Bare C<-o path> means C<-o configure:path>.
The last mapping for each name wins.  Only the first colon separates
name from path.  Prefix a bare filename containing a colon with C<./>.
Unknown names and empty paths are errors.  Parent directories must exist.

F<configure> goes in the current directory, or wherever its mapping says
(seen from here, or absolute).  F<render> goes in the project root
(C<-SA>), and a mapping for it names it as seen from there -- the same
name that it declares as its C<HAVE> and that the rulebook uses.  Since
that name ends up in a C<HAVE>, it may not contain white space (space,
tab, newline, vertical tab, form feed, carriage return; a no-break space
is no white space), begin with C<">, or end with C<"> or C<?>.

A destination of F</dev/null> suppresses that output.  Mapping C<render>
requires a preset that supplies it.  Existing files are left alone unless
C<-f> is passed, including at explicitly mapped destinations.

For example:

    siteconf init -P web -o configure:tools/configure \
        -o render:bin/render-page

This does not rewrite your rulebook.  Update its renderer path in both
the dependency and the recipe.  (The renderer's own header C<NEED>s
F<MY/option.mk>, so option changes still rebuild its targets.)

    index.html: ${A}/bin/render-page
        cd ${A:Q} && ${^X} bin/render-page -B ${B:Q} ${a}/index.html ${B:Q}/${b}/index.html

Named mappings are only for C<-i>.

=item B<-f>

With C<-i>, overwrite existing configure and renderer files.  Without it,
existing files are skipped, and processing continues.  F</dev/null> still
suppresses an output even with C<-f>.  New files are reported as C<Wrote>,
and replaced files as C<Overwrote>.

An existing file that is skipped is reported as C<Not changing>.  Init
fails (status 1) if F<configure> already exists and was therefore not
written; suppressing it with F</dev/null> is not a failure, and neither
is a skipped renderer.

=item B<-q>, B<--quiet>

Say nothing but errors: not the C<WANT>s that were dropped, nor the
files that are written, updated, or removed, nor what to run to
build.  (F<configure> takes C<-q> too.)

=item B<-F> I<manifest>

Specifies a different manifest to use.
Overrides the configured C<F>.  Like it, this is a path from the
current directory (not from C<${A}>, like everything else).

=item B<-R> I<rulebook>

Specifies a different rulebook to use.
Overrides the configured C<R>.  Like it, this is a path from the
current directory.

=item B<-l>, B<list>

Print the names that the manifest (F<MANIFEST>, or C<-F>; nothing is
configured for this) gives its default goal, the first: what it
C<NEED>s, then what it C<WANT>s, as they are written there --
unescaped, but not resolved (a C<WANT> that would be dropped is still
listed), and each once.  They are relative to C<${a}>, and to
C<${B}/${b}> once made.

Each name is followed by a newline (or C<-0>), and is written as the
file system spells it (as F<siteconf> would open it: B<filesys> of
L<RdKw::I18N::CodeSets>): by default in the locale's encoding, but on
macOS always in UTF-8, as its file names are.  A name it cannot spell
is an error, and nothing is written; so is one with the separator in
it.

To list what a build made, list what F<siteconf -g> resolved, from
which every C<WANT> that could not be made is gone:
C<-F /MY/MANIFEST.>I<goal>.  The manifest itself still has them.

=item B<-t> [I<goal>][B<:NEED>|B<:WANT>]

With C<-l>, list what I<goal> (the default one, if left out) says,
instead: both C<NEED> and C<WANT>, or only the one that is given.
May be given more than once, in which case the lists are joined (and
a name is still listed once).  So C<-t :NEED> is what the default goal
needs, and C<-t all -t small> everything that either of them says.

=item B<-t> [B<NEED:>|B<WANT:>]I<goal>

With C<-g>, generate only the selected goals, in the order requested.
C<-t goal> and C<-t NEED:goal> keep the manifest's C<NEED> and
C<WANT> declarations.  C<-t WANT:goal> treats every file in that goal
as C<WANT>ed, so files that cannot be built are warned about and dropped.
The prefix goes before the goal, unlike the filter used with C<-l>.

May be repeated; a repeated goal appears once, at its first position,
with the last prefix given for it.  The first selected goal is the
default build goal.  Without C<-t>, all manifest goals are generated
as declared, as before.

=item B<-0>[I<octal>]

With C<-l>, end each name with the character of that octal number
(up to C<377>, a byte), instead of a newline, as with L<perl(1)>'s
C<-0>: a NUL by itself, as for C<xargs -0> and C<tar --null>, or
C<-072> for a colon.  C<-012> is the default.

=back

=head1 ENVIRONMENT

=over

=item C<SITECONF_CODESETS>

What code sets to read and write in, instead of the locale's: see
L<RdKw::WwW::SiteConf::Configure/ENVIRONMENT>.  C<-C> overrides it.
F<configure> and F<render> read it too (and take C<-C> as well).

=back

=cut

use version;

use Data::Dumper ();
use File::Basename qw( basename dirname );
use File::ShareDir ();
use File::Spec;
use Getopt::Long qw( GetOptionsFromArray );
use IO::Handle ();  # for $fh->flush() prior to 5.014

use Encode ();
use RdKw::I18N::CodeSets ();
use RdKw::L10N::TextDomain ':module' => 'RdKw::WwW::SiteConf::L10N';
use RdKw::WwW::GenGenLib 0.01 qw( escape_dep read_manifest );
use RdKw::WwW::SiteConf;

# GenLib with non-broken varargs locate
our $GENLIB_NEW = '0.0203';
# GenGenLib that is locale-aware (and has norm_dep, subs_dep and
# uproot): what configure and render are written for, and no older
our $GENGENLIB_MIN = '0.0100';
# Our preferred provider, if (and only if) the user requests it via -M
our $PROVIDER = 'RdKw::WwW::GenGenLib::Template::Provider';

# Early init (this is apparently the only time
# we use the "E:" prefix, other than user errors)
my $cs = RdKw::I18N::CodeSets->new;
my $me = basename($0);
$cs->parse_from_env('SITECONF_CODESETS', prog => $me);
my $offset = $cs->parse_from_argv(\@ARGV, prog => $me);
RdKw::I18N::CodeSets->locale($cs);
$cs->initstd( stderr => Encode::FB_PERLQQ() );

# Now we can has real prog :]
my $prog = basename($cs->un_argv($0, { check => Encode::FB_PERLQQ() }));

# How to invoke us: `usage: ' (or a translated
# string under the current locale).  Each sub-
# sequent line is indented to match its width.
my $usage = do {
	my ($before, $after) = split /\0/, $cs->diag(__("usage: %s"), "\0"), 2;
	defined $after or $after = '';
	my $pad = ' ' x _width($before);
	"$before$prog [-C codeset ...] [-q] [-i|-g|-l|-V] [<args>]$after\n"
	. join '', map { "$pad$prog $_\n" }
		"-i [-P preset] [-o [name:]path ...] [-f] [-M[-]module[=version] ...]\n"
		. "$pad         [-Sopt=val ...] [-Dvar=val ...] [-Ovar=val ...]",
		"-g [-B builddir] [-G generator] [-F manifest] [-R rulebook]\n"
		. "$pad         [-o file] [-t [NEED:|WANT:]goal ...]",
		"-l [-F manifest] [-t [goal][:NEED|:WANT] ...] [-0[octal]]",
		"-V [-V]";
};

# How wide a string is on a terminal: two columns for each character
# that is wide (as CJK is), and one for each other
sub _width
{
	my ($s) = @_;
	my $wide = eval { scalar(() = $s =~ /[\p{Ea=W}\p{Ea=F}]/g) } || 0;
	length($s) + $wide;
}

@ARGV = $cs->un_argv(@ARGV, { start => 1 + $offset, prog => $prog });

Getopt::Long::Configure(qw( bundling no_ignore_case ));
my %opt = (S => {}, D => {}, O => {}, M => [], outputs => [], t => []);
# What `-i' was told, in the order it was told, for the header of
# configure.  (Leaving out what does not alter its text: -i, -o, -f, -q.)
my @written;
GetOptions(
	'i|init'   => sub { $opt{mode} = 'init' },
	'g|make'   => sub { $opt{mode} = 'make' },
	'l|list'   => sub { $opt{mode} = 'list' },
	'P=s'      => sub { $opt{P} = $_[1]; push @written, "-P", $_[1] },
	'o=s'      => sub { push @{ $opt{outputs} }, $_[1] },
	'M=s'      => sub { push @{ $opt{M} }, $_[1]; push @written, "-M$_[1]" },
	'B=s'      => \$opt{B},
	'G=s'      => \$opt{G},
	'S=s%'     => sub { $opt{S}{$_[1]} = $_[2]; push @written, "-S$_[1]=$_[2]" },
	'D=s%'     => sub { $opt{D}{$_[1]} = $_[2]; push @written, "-D$_[1]=$_[2]" },
	'O=s%'     => sub { $opt{O}{$_[1]} = $_[2]; push @written, "-O$_[1]=$_[2]" },
	'F=s'      => \$opt{F},
	'R=s'      => \$opt{R},
	't=s'      => $opt{t},
	# (-0 alone is a NUL, -072 a colon: an octal number, as perl's -0 takes)
	'0:s'      => \$opt{0},
	'h|help'   => sub { print $usage; exit 0 },
	'V|version+' => \( my $vee ),
	'q|quiet'  => \$opt{q},
	'f'        => \$opt{f},
	# Reject misplaced -C arguments
	'C:s'      => sub { die "$prog: " . __("too late to -C now.") . "\n" },
) or die $usage;

if ($vee) {
	print <<VAR;
$prog version $RdKw::WwW::SiteConf::VERSION
VAR

	exit unless $vee > 1;
	print <<LVER;
perl version $], @{[ $cs->un_fs($^X) ]}
I18N::CodeSets version $RdKw::I18N::CodeSets::VERSION
L10N::TextDomain version $L10N::TextDomain::VERSION
WwW::GenGenLib version $RdKw::WwW::GenGenLib::VERSION
LVER

	foreach my $fren (qw(
		Template URI URI::Escape RdKw::WwW::GenLib
		RdKw::WwW::GenGenLib::Template::Provider
	)) {
		(my $path = "$fren.pm") =~ s!::!/!g;
		eval { require $path; 1 } or next;
		(my $cheeky = $fren) =~ s/^RdKw:://;
		# Obtain version without using symbolic ref :x
		print "$cheeky version " . $fren->VERSION() . "\n";
	}
	exit;
}

# `siteconf init', `siteconf make', `siteconf list'
if (@ARGV and $ARGV[0] =~ /\A(?:init|make|list)\z/) {
	my $word = shift @ARGV;
	defined $opt{mode} and $opt{mode} ne $word
		and die "$prog: " . $cs->diag(__("conflicting modes: %s and %s"), $opt{mode}, $word) . "\n";
	$opt{mode} = $word;
}
defined $opt{mode} or die $usage;
@ARGV and die "$prog: " . __("too many arguments") . "\n";

# Keep output routing separate from the defaults written into configure.
for my $output (@{ $opt{outputs} }) {
	my ($name, $path) = ('configure', $output);
	if ($output =~ m!\A([^/:]+):(.*)\z!s) {
		($name, $path) = ($1, $2);
		$opt{mode} eq 'init'
			or die "$prog: " . __("named outputs are only for init") . "\n";
		$name eq 'configure' || $name eq 'render'
			or die "$prog: " . $cs->diag(__("unknown output name: %q"), $name) . "\n";
	}
	length $path or die "$prog: " . __("empty output path") . "\n";
	$opt{mode} eq 'init' ? ($opt{output}{$name} = $path) : ($opt{o} = $path);
}

# This is the same string bsdtar uses (modulo casing)
# $ tar -taf /dev/null
# tar: Option -a is not permitted in mode -t
sub _not_for_us {
	die "$prog: " . $cs->diag(
		__("%s is not permitted in mode %s"), @_) . "\n";
}

if ($opt{mode} eq 'init') {
	foreach (qw( 0 B F G R )) {
		defined $opt{$_} and _not_for_us("-$_", '-i (init)');
	}
	foreach (qw( t )) {
		@{ $opt{$_} } and _not_for_us("-$_", '-i (init)');
	}
	$opt{written} = \@written;
	exit do_init(\%opt);
} elsif ($opt{mode} eq 'list') {
	foreach (qw( P f B G R o )) {
		defined $opt{$_} and _not_for_us("-$_", '-l (list)');
	}
	foreach (qw( M )) {
		@{ $opt{$_} } and _not_for_us("-$_", '-l (list)');
	}
	foreach (qw( S D O )) {
		%{ $opt{$_} } and _not_for_us("-$_", '-l (list)');
	}
	exit do_list(\%opt);
} else {
	# Just as a side remark, I don't think `siteconf make'
	# makes a lot of sense sense.  it stands for generate, but
	# i wrote make so that it'd be four letters like init.
	foreach (qw( 0 P f )) {
		defined $opt{$_} and _not_for_us("-$_", '-g (make)');
	}
	foreach (qw( M )) {
		@{ $opt{$_} } and _not_for_us("-$_", '-g (make)');
	}
	foreach (qw( S D O )) {
		%{ $opt{$_} } and _not_for_us("-$_", '-g (make)');
	}
	my %Doverrides;
	foreach my $Dk (qw( F R )) {
		if (defined $opt{$Dk}) {
			$Doverrides{$Dk} = $opt{$Dk};
		}
	}
	my $sc = RdKw::WwW::SiteConf->new(
		%Doverrides ? ( D => \%Doverrides ) : (),
		B => $opt{B},
		quiet => $opt{q},
		prog => $prog,
		goals => $opt{t},
	);
	$sc->generate($opt{G}, $opt{o});
}
exit;

# ---

# `siteconf -l': the names, for other programs (tar -T, xargs -0), so
# they are spelled as the file system does -- and not as a message is,
# with \x{...} for what cannot be: a name we cannot spell is an error.
sub do_list
{
	# aw, Why not leave it to PerlIO? :(
	binmode STDOUT, ':raw';

	my ($opt) = @_;
	my $sep = "\n";
	if (defined $opt->{0}) {
		$opt->{0} =~ /\A[0-7]{0,3}\z/
			&& (my $ord = oct($opt->{0} || 0)) <= 0377
			or die "$prog: " . $cs->diag(__(
				"%#q: not a valid ASCII octal code point"),
				"-0$opt->{0}") . "\n";
		$sep = chr $ord;
	}
	my $file = defined $opt->{F} ? $opt->{F} : 'MANIFEST';
	eval {
		my $mf = read_manifest($file);
		my (%seen, @name);
		for my $t (@{ $opt->{t} } ? @{ $opt->{t} } : ':') {
			my ($goal, $type) = split /:/, $t, 2;
			length $goal or undef $goal;
			my @kind = !defined $type || $type eq '' ? qw( needed wanted )
				: $type eq 'NEED' ? 'needed'
				: $type eq 'WANT' ? 'wanted'
				: die $cs->diag(__("%q: expected NEED or WANT, not %q"),
					"-t $t", $type) . "\n";
			push @name, grep { !$seen{$_}++ } map { $mf->$_($goal) } @kind;
		}
		for my $name (@name) {
			my $fs = $cs->to_fs($name, { prog => $mf->file });
			index($fs, $sep) < 0 or die $cs->diag(__(
				# HEY!  the %s is the separator, as the option that
				# says it: -0 for a NUL, -012 for a newline
				"%q: %q conflicts with record separator %s"),
				$file, $name, sprintf('-0%o', ord $sep)) . "\n";
			print STDOUT $fs, $sep or die "$prog: " . $cs->diag(__(
				"cannot write to stdout: %m")) . "\n";
		}
		1;
	} or do {
		(my $why = $@) =~ s/\Aread_manifest: //;
		die "$prog: $why";
	};
	STDOUT->flush() or die "$prog: " . $cs->diag(__("cannot write to stdout: %m")) . "\n";
	0;
}

# `share' lives where File::ShareDir finds it: alongside the modules
# we were loaded from (so under blib/ in a built checkout), and nowhere
# else.  No environment variable, no path relative to us.
sub share_file
{
	my ($file) = @_;
	my $path = eval { File::ShareDir::dist_file('WwW-SiteConf', $file) };
	defined $path or die "$prog: " . $cs->diag(__("cannot find %q (is WwW-SiteConf installed?)"),
		"share/$file") . "\n";
	$cs->un_fs($path, { prog => $prog });
}

sub slurp
{
	my ($file) = @_;
	open my $fh, '<:encoding(UTF-8)', $cs->to_fs($file, { prog => $prog })
		or die "$prog: " . $cs->diag(__("cannot open file %q: %m"), $file) . "\n";
	my $text = do { local $/; readline $fh };
	close $fh or die "$prog: " . $cs->diag(__("cannot read file %q: %m"), $file) . "\n";
	$text;
}

# A Perl string literal
sub pq
{
	my ($s) = @_;
	Data::Dumper->new([$s])->Terse(1)->Indent(0)->Useqq(1)->Dump();
}

# Perl key preceding a fat comma
sub pK
{
	my ($K) = @_;
	($K !~ /[^0-9A-Z_a-z]/) ? $K : pq($K);
}

sub hash_lines
{
	my ($H) = @_;
	join "\n", map {
		"\t@{[ pK($_) ]} => @{[ pq($H->{$_}) ]},"
	} sort keys %$H;
}

# What `-i' was told, as comment lines (none, if it was told nothing)
sub args_comment
{
	my ($args) = @_;
	return '' unless @$args;
	my $line = join ' ', map { RdKw::WwW::SiteConf::shell_quote($_) } @$args;
	$line =~ s/\n/\n# /g;
	"# options: $line\n#\n";
}

sub do_init
{
	my ($opt) = @_;
	my %S = %{ $opt->{S} };

	# What -S sets: where we are, and the defaults for A B a b c R F e clean.
	my %Dd = (
		A => '.',
		B => '.',
		a => 'html',
		b => 'site',
		R => 'Makefile.in',
		F => 'MANIFEST',
		e => '.ok',
		clean => 'clean',
	);
	# Well-known options
	my %OD = (
		base_url => N__('Host-relative base URL'),
		site_url => N__('Absolute base URL'),
	);
	for my $k (keys %S) {
		# HEY!  %s is the option (-Sx), and then what it may be
		exists $Dd{$k} || $k eq 'c' or die "$prog: " . $cs->diag(__("%s: no such thing (valid: %s)"),
			"-S$k", 'A B a b c R F e clean') . "\n";
		$Dd{$k} = $S{$k};
		# HEY!  %s is an option, as -Sa (and likewise in the next few)
		length $Dd{$k} or die "$prog: " . $cs->diag(__("%s may not be empty."), "-S$k") . "\n";
	}
	File::Spec->file_name_is_absolute($Dd{b})
		and die "$prog: " . $cs->diag(__("%s must be a relative path."), '-Sb') . "\n";
	# c is always there; the same as b means it goes where b goes
	exists $Dd{c} or $Dd{c} = $Dd{b};
	File::Spec->file_name_is_absolute($Dd{c})
		and die "$prog: " . $cs->diag(__("%s must be a relative path."), '-Sc') . "\n";

	# -D and -O set what defaults to have in addition.
	for my $k (sort keys %{ $opt->{D} }) {
		exists $opt->{S}{$k}
			and die "$prog: " . $cs->diag(__("%s and %s are the same thing; pick one."),
				"-S$k", "-D$k") . "\n";
	}
	my %Dx = (%Dd, %{ $opt->{D} });
	# (-Db here moves c too, unless c is said)
	exists $S{c} || exists $opt->{D}{c} or $Dx{c} = $Dx{b};
	# -SA or -DA: where render goes, too
	my $A = $Dx{A};
	length $A or die "$prog: " . $cs->diag(__("%s may not be empty."), '-DA') . "\n";
	my %Ox = %{ $opt->{O} };

	my $preset = '';
	my $render;
	if (defined $opt->{P} and $opt->{P} ne 'none') {
		$opt->{P} =~ /\A\w+\z/ or die "$prog: " . $cs->diag(__("bad preset name: %q"), $opt->{P}) . "\n";
		my $file = eval { share_file("presets/$opt->{P}.config") }
			or die "$prog: " . $cs->diag(__("no such preset: %q"), $opt->{P}) . "\n";
		$preset = slurp($file);
		$preset =~ s/\n*\z/\n/;
		$render = eval { share_file("presets/$opt->{P}.render") };
	}
	# configure must find these: what the preset says (in `# USE:
	# module[=version]' lines), then -Mmodule or -Mmodule=version.  Keyed
	# by module, so that a later one replaces the earlier.  -M-module
	# (or -Mmodule=, with nothing after the =) drops it.
	my %mods = (
		'RdKw::I18N::CodeSets' => 0,
		'RdKw::WwW::GenGenLib' => $GENGENLIB_MIN,
	);
	my @spec = ($preset =~ /^# USE: (\S+)$/mg, @{ $opt->{M} });
	my %user;
	for my $m (@spec) {
		my ($drop, $module, $min) = $m =~ /\A(-?)([^=]*)(?:=(.*))?\z/s;
		# HEY!  %s is the option, as -MModule=version (here and
		# in the next four)
		$module =~ /\A\w+(?:::\w+)*\z/ or die "$prog: " . $cs->diag(__("%s: bad module name"), "-M$m") . "\n";
		$drop && defined $min
			and die "$prog: " . $cs->diag(__("%s: no version for what is dropped"), "-M$m") . "\n";
		my $said = defined $min;
		$min = $drop ? '' : 0 unless $said;
		$min =~ /\A(?:v?[0-9][0-9._]*|0|)\z/ or die "$prog: " . $cs->diag(__("%s: bad version"), "-M$m") . "\n";
		if ($min eq '') {
			$module eq 'RdKw::WwW::GenGenLib' || $module eq 'RdKw::I18N::CodeSets'
				and die "$prog: " . $cs->diag(__("%s: configure always needs it"), "-M$m") . "\n";
			delete $mods{$module};
		} elsif ($module eq 'RdKw::WwW::GenGenLib' && !version_ge($min, $GENGENLIB_MIN)) {
			# (with no version, it is the one we ask for anyway)
			$said and die "$prog: " . $cs->diag(__("%s: version %s or later is required"),
				"-M$m", $GENGENLIB_MIN) . "\n";
			$mods{$module} = $GENGENLIB_MIN;
		} else {
			$mods{$module} = $min;
		}
		$user{$module} = 1;
	}
	# Test how far we could go, with user overrides taken into account.
	if (defined $render) {
		# (what the preset said, if it says anything: -P tem does not)
		$opt->{genlib_min} = $mods{'RdKw::WwW::GenLib'};
		# (only ever because -M said so: no preset asks for it)
		$opt->{provider} = $user{$PROVIDER} && exists $mods{$PROVIDER};
	}
	my @mod = map { "\t\t[ " . pq($_) . ", " . pq($mods{$_}) . " ]," } sort keys %mods;
	exists $opt->{output}{render} && !defined $render
		and die "$prog: " . __("preset does not supply a render output") . "\n";
	# render names itself in a HAVE, and read_deps cannot take just
	# anything there (" is reserved for an escape mechanism, and ?
	# is for soft-deps).
	if (defined(my $path = $opt->{output}{render})) {
		$path eq '' || $path =~ /\A"/ || $path =~ /[?"]\z/ || $path =~ /[\t\n\cK\f\r ]/
			and die "$prog: " . $cs->diag(__("dangerous name for render: %q is not supported (yet)"),
				$path) . "\n";
	}
	# The help of configure, as rows of its tables (see there): -D beyond
	# B a b R F e clean (which configure already describes), and -O, with
	# what we know of them (said with __ there, so N__ here)
	my @Dextra = grep { !exists $Dd{$_} && $_ ne 'c' } sort keys %Dx;
	my $dhelp = join '', map {
		"\t[ " . pq("-D$_") . ', "", sub { $Dd{' . pK($_) . "} } ],\n"
	} @Dextra;
	my $help = join '', map {
		"\t[ " . pq("-O$_") . ', ' . (exists $OD{$_} ? 'N__(' . pq($OD{$_}) . ')' : '""')
			. ', sub { $Od{' . pK($_) . "} } ],\n"
	} sort keys %Ox;
	my $text = slurp(share_file('configure.in'));
	my %sub = (
		PROG => $prog,
		VERSION => $RdKw::WwW::SiteConf::VERSION,
		ARGS => args_comment($opt->{written}),
		DDEF => hash_lines(\%Dx),
		ODEF => hash_lines(\%Ox),
		MODULES => join("\n", @mod),
		PRESET => $preset,
		DEFHELP => $dhelp,
		OPTHELP => $help,
	);
	$text =~ s/@(\w+)@/exists $sub{$1} ? $sub{$1} : die "$prog: configure template: \@$1\@?\n"/ge;

	my $out = exists $opt->{output}{configure} ? $opt->{output}{configure} : 'configure';
	my %out = ( configure => $out );
	if (defined $render) {
		my $name = defined $opt->{output}{render} ? $opt->{output}{render} : 'render';
		my $dest = $name eq '/dev/null' ? $name : File::Spec->catfile($A, $name);
		$out{render} = $dest;
	}

	my %written;
out:	while (my ($name, $dest) = each %out) {
		next if $dest eq '/dev/null';
		my $dest_fs = $cs->to_fs($dest, { prog => $prog });
		my $exists = (-e $dest_fs || -l $dest_fs);
		if (!$opt->{f} && $exists) {
			print STDERR
				$cs->diag(__("Not changing %#q"), $dest),
				"\n" unless $opt->{q};
			next out;
		}
		if ($exists && !(-l $dest_fs || unlink $dest_fs)) {
			print STDERR "$prog: ",
				$cs->diag(__("cannot remove %q: %m"), $dest),
				"\n" unless $opt->{q};
		}
		my $contents;
		if ($name eq 'configure') {
			$contents = $text;
		} elsif ($name eq 'render') {
			$contents = render_text($opt, $render);
		} else {
			die "Unreachable\n";
		}
		open my $fh, '>:encoding(UTF-8)', $dest_fs
			or die "$prog: "
				. $cs->diag(__("cannot create file %q: %m"), $dest)
				. "\n";
		print $fh $contents or die "$prog: "
			. $cs->diag(__("cannot write file %q: %m"), $dest) . "\n";
		close $fh or die "$prog: "
			. $cs->diag(__("cannot write file %q: %m"), $dest) . "\n";
		unless (chmod 0777 & ~umask, $dest_fs) {
			print STDERR "$prog: ",
				$cs->diag(__("cannot chmod %q: %m"), $dest),
				"\n" unless $opt->{q};
		}
		$written{$name} = 1;
		# HEY!  "Overwrote" clobbers a file the user
		# explicitly lets us with -f, and "wrote" means
		# the file is simply created.  I don't know why
		# Claude felt the need to clarify this; this
		# seems pretty clear to me. :/
		print STDERR $cs->diag(
			$exists ? __("Overwrote %#q") : __("Wrote %#q"), $dest),
			"\n" unless $opt->{q};
	}
	unless ($written{configure} || $out{configure} eq '/dev/null') {
		my $msg = ($out{configure} eq 'configure'
			? __("You already have configure.")
			: $cs->diag(__("You already have configure at %q."), $out{configure}))
			. "\n" . __(
			"Pass -o /dev/null if you did mean to not generate configure,\n"
			. "or -f to overwrite the existing one.");
		# I really don't like the name Claude
		# gave this function but in the mean-
		# time I don't have a better one either.
		print STDERR RdKw::WwW::SiteConf::_say(E => $msg) unless $opt->{q};
		return 1;
	}
	return 0;
}

sub version_ge
{
	my ($have, $want) = @_;
	my $ok = eval { version->parse($have) >= version->parse($want) };
	$ok ? 1 : 0;
}

# Generates <preset>.render.
sub render_text
{
	my ($opt, $render) = @_;
	my ($path, $name, $path_q);
	if (defined $opt->{output}{render}) {
		$path = $opt->{output}{render};
		$name = basename($path) eq 'render'
			? 'render' : "$path (render)";
	} else {
		$path = 'render';
		$name = 'render';
	}
	$path_q = RdKw::WwW::SiteConf::shell_quote($path);
	my $text = slurp($render);
	my $can_valoc = version_ge($opt->{genlib_min}, $GENLIB_NEW);
	my $provider = $opt->{provider};
	my %sub = (
		# (a spec, in its HAVE and in Makefile.in: a $ is a $)
		PATH => escape_dep($path, unicode => 1),
		PATH_Q => $path_q,
		NAME => $name,
		# Template opens the files itself: by the names
		# the file system knows them by.
		# (the provider names files itself)
		APATH_FS => $provider ? '$apath' : "\$cs->to_fs(\$apath, { prog => 'E' })",
		USE_PROVIDER => $provider ? "use $PROVIDER;\n" : '',
		TT_NEW => $provider
			? <<"NEW"
# This provider encodes file paths to the system locale,
# and additionally grants access to named dependencies
# that are declared in the same headers siteconf reads.
# Namely, the NEEDs and WANTs are followed recursively
# starting at the SOURCE and added to a whitelist that
# bypasses the regular RELATIVE / ABSOLUTE restrictions.
# This whitelist can be disabled with ALLOW_DEPS => 0.
# You can also require that all file access be declared
# with such a dependency header with CHECK_DEPS => 1,
# in case that helps keeping your templates up-to-date.
#
# By default, any symbolic prefix is permitted, although
# only the standard `\${a} \${B}/\${b} \${B}/\${c}' are tried
# for constructing a plausible symbolic name.  To define
# an explicit whitelist of symbolic prefixes, specify
# ALLOW_PREFIXES.  To have additional prefixes considered
# for a symbolic names, specify PREFIXES.  In both cases
# the list is comprehensive, so it is possible to remove
# a standard prefix by omitting it from the list.
#
# Options are documented in the perldoc of
# $PROVIDER.
#
my \$provider = $PROVIDER->new({
	SOURCE => \$apath,
	DEFINITION => \$D,
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', \$D->{a} ],
})
	or die "[TT] ", $PROVIDER->error(), "\\n";
my \$tt = Template->new({
	LOAD_TEMPLATES => [ \$provider ],
})
	or die "[TT] ", \$Template::ERROR, "\\n";
NEW
			: <<\OLD,
my $tt = Template->new({
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', $cs->to_fs($D->{a}, { prog => 'E' }) ],
})
	or die "[TT] ", $Template::ERROR, "\n";
OLD
		USE_GENLIB => $can_valoc
			? "use RdKw::WwW::GenLib $GENLIB_NEW qw( locate );"
			: 'use RdKw::WwW::GenLib qw( locate );',
		USE_TT_EXC => $can_valoc ? '' : <<\OLD,
use Template::Exception;
OLD
		V_LOCATE => $can_valoc
			? <<\NEW
	locate => sub { locate($O, $target, @_); },
NEW
			: <<\OLD,
	locate => sub {
		@_ == 1 or die Template::Exception->new(usage => "[% locate PATH %]");
		locate($O, $target, @_);
	},
OLD
	);
	$text =~ s/@(\w+)@/exists $sub{$1} ? $sub{$1} : die "$prog: $opt->{P}.render template: \@$1\@?\n"/ge;
	$text;
}
