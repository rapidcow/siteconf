#!perl
#
# t/task.t - Makefile.in recipes as a Taskfile.yml

use utf8;
use strict;
use warnings;
use Test::More tests => 31;
# Pin LANGUAGE to C so gettext does not translate the messages matched below.
BEGIN { $ENV{LANGUAGE} = 'C' }
use RdKw::I18N::CodeSets;
use RdKw::WwW::SiteConf::Builder::Task;

my $class = 'RdKw::WwW::SiteConf::Builder::Task';
sub codesets { local $ENV{T_CODESETS} = $_[0]; RdKw::I18N::CodeSets->locale->parse_from_env('T_CODESETS', prog => 't') }
codesets('filesys:UTF-8,argv:UTF-8');

# --- YAML scalars: always double-quoted
my %yaml = (
	'NULL' => '"NULL"', 'True' => '"True"', '0x10' => '"0x10"', '' => '""',
	"a\tb" => '"a\u0009b"', 'say "hi"' => '"say \"hi\""', 'a\\b' => '"a\\\\b"',
	"\x{2028}" => '"\u2028"', "\x{85}" => '"\u0085"', "é" => "\"é\"",
);
is(RdKw::WwW::SiteConf::Builder::Task::_yaml($_), $yaml{$_}, "YAML: " . join(' ', map { sprintf 'U+%04X', ord } split //, $_))
	for sort keys %yaml;

# --- task names
sub tn { RdKw::WwW::SiteConf::Builder::Task::_task_name(@_) }
is(tn('all', 1), 'all', 'a goal is its name');
is(tn('a=b'), 'goal:a%3db', '= is an assignment to Task');
is(tn('a*'), 'goal:a%2a', '* is a wildcard');
is(tn('-x'), 'goal:%2dx', 'a - in front is an option');
is(tn('default'), 'goal:default', 'default, unless it is the first goal');
is(tn('default', 1), 'default', '... which it may be');
is(RdKw::WwW::SiteConf::Builder::Task::_file_task('a{{b}}%*'), 'file:a%7b%7bb%7d%7d%25%2a',
	'a file task is never a template or a wildcard');

# --- a plan
my $plan = {
	prog => 'test', args => [], D => { e => '.ok' },
	goals => [ { name => 'all', files => ['x'] }, { name => 'a=b', files => ['y'] } ],
	order => ['y', 'x'], dirs => [ { dir => 'site', marker => 'site/.ok', deps => [] } ],
	node => {
		y => { bpath => 'y', deps => [], recipe => [ [ text => "\ttouch y\n", 'y' ] ] },
		x => { bpath => 'site/x', deps => [ 'in/x', 'y', 'site/.ok' ],
			recipe => [ [ text => "\t\@cp in/x ", 'x' ], [ word => 'site/x', 'x' ],
				[ text => "\n\t-echo \$\$HOME '{{x}}'\n", 'x' ] ] },
	},
	clean => [ { name => 'clean', files => [ 'site/x', 'y' ] } ],
	opt => {},
};
my $text = RdKw::WwW::SiteConf::Builder::Task->_text($plan);
like($text, qr/\A#\n# Taskfile\.yml!\n# \(generated by `test' :D\)\n#\nversion: "3"\nrun: "once"\n\ntasks:\n/,
	'header, then version and run once');
like($text, qr/^  "all":\n    aliases: \["default"\]\n    deps: \["file:site\/x"\]\n/m, 'the first goal is the default');
like($text, qr/^  "goal:a%3db":\n    deps: \["file:y"\]\n/m, 'a goal with = in it');
like($text, qr/^  "clean":\n    cmds:\n      - "rm -f -- site\/x y"\n/m, 'clean');
like($text, qr/^  "file:y":\n    status: \["test -e y"\]\n    cmds:\n      - "\/bin\/sh -c 'touch y'"\n/m,
	'nothing needed: up to date if it is there');
like($text, qr/^  "file:site\/x":\n    deps: \["file:y"\]\n    status: \["test -e site\/x", "test ! in\/x -nt site\/x", "test ! y -nt site\/x"\]\n/m,
	'what is made here is a dep; it is up to date unless what it needs (not the marker) is newer');
like($text, qr/^      - "mkdir -p -- site"\n      - "\/bin\/sh -c 'cp in\/x site\/x'"\n      - cmd: "\/bin\/sh -c 'echo \$HOME '\\\\''\{\{\\"\{\{\\"\}\}x\}\}'\\\\'''"\n        ignore_error: true\n/m,
	'mkdir, then each line by sh: @ dropped, $$ is $, - ignores the error, {{ escaped');

$plan->{opt} = { arg_max => 6 };
like(RdKw::WwW::SiteConf::Builder::Task->_text($plan), qr/^      - "rm -f -- site\/x"\n      - "rm -f -- y"\n/m, '-Sarg_max');

is(join(' ', $class->build_command('task', '.', undef, 'all')), 'task all', 'build: task goal');
is(join(' ', $class->build_command('task', 'b d', 'T.yml', 'a=b')), q(task -t 'b d/T.yml' goal:a%3db), '... -t, and the goal as written');
is(join(' ', $class->build_command('task', 'build', undef, undef)), 'task -d build', '... -d');

# --- what cannot be said
$plan->{node}{x}{recipe} = [];
ok(!eval { $class->_text($plan); 1 }, 'no recipe, no task');
like($@, qr/no recipe/, '... says so');
codesets('filesys:ISO-8859-1,argv:UTF-8');
$plan->{node}{x}{recipe} = [ [ text => "\ttouch ", 'x' ], [ word => "caf\x{e9}", 'x' ] ];
$plan->{node}{y}{bpath} = "caf\x{e9}";
like(eval { $class->_text($plan) } || $@, qr/is not UTF-8/, 'a name the file system spells in Latin-1 is an error');
