msgstr "%q line %s"

#. HEY!  Keep a winky face in the translation ;)
#. (as GenGenLib's load_state does: newbies see it)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:349
msgid ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"
msgstr ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:365
msgid "%q: %q is missing.  Try reconfiguring."
msgstr "%q: %q is missing.  Try reconfiguring."

#. HEY!  %q is a variable of config.mk: `b' or `c', which are where
#. what we make goes (the target tree, and the cache)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:370
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:374 ../siteconf/share/configure.in:315
#: ../siteconf/share/configure.in:324
msgid "%q prefix must be a relative path."
msgstr "%q prefix must be a relative path."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:376
msgid "%q prefix may not climb out of the build directory."
msgstr "%q prefix may not climb out of the build directory."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:378
msgid "%q (directory marker) may not contain a slash."
msgstr "%q (directory marker) may not contain a slash."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:380
msgid "%q may be made of letters, digits and -_.+& only: %q"
msgstr "%q may be made of letters, digits and -_.+& only: %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:388
msgid "cannot find the build directory %q: %m"
msgstr "cannot find the build directory %q: %m"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:391
msgid "cannot find the source tree %q: %m"
msgstr "cannot find the source tree %q: %m"

#. HEY!  The first %s is where (a file, or `file' line 3), and
#. the second is b or c (a variable of config.mk, as in ${b}).
#. Leave the ${...}s alone: they are what is written in a header.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:456
#, perl-brace-format
msgid "%1$s: %2$q: ${%3$s} is relative to ${B}; write ${B}/${%3$s}"
msgstr "%1$s: %2$q: ${%3$s} is relative to ${B}; write ${B}/${%3$s}"

#. HEY!  the last %s is what is in a header, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:473
msgid "%s: %q: %s is no code point"
msgstr "%s: %q: %s is no code point"

#. HEY!  the last %s is the variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:479
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:258
msgid "%s: %q: no such variable %s"
msgstr "%s: %q: no such variable %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:483
msgid "%s: stray $ in %q"
msgstr "%s: stray $ in %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:488
#, perl-format
msgid "%s: empty path"
msgstr "%s: empty path"

