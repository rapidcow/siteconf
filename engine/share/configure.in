#!/usr/bin/env perl
#
# configure -- written by `@PROG@ -i' version @VERSION@.
#
# Keep local changes as a patch on top of this file (it is generated
# deterministically, so the same arguments give the same text and the
# patch keeps applying), rather than editing it in place and losing
# them the next time `@PROG@ -i' is run.
#
@ARGS@use utf8;
use 5.008;
use strict;
use warnings;

use Cwd qw( getcwd abs_path );
use File::Basename;
use File::Spec;
use FindBin;
use Getopt::Long qw( GetOptions );

# --- requirements: [ module, minimum version ], from `@PROG@ -i -M'.
# The requirements of the preset, if any, is appended here too.
our @NEED;
BEGIN {
	@NEED = (
@MODULES@
	);
}
@PRESET@
# ---

# Look before we load: a missing module is reported by us, all
# of them at once, and not by the first `use' to trip over it.
BEGIN {
	my @bad;
	foreach my $need (@NEED) {
		my ($module, $min) = @$need;
		(my $file = "$module.pm") =~ s!::!/!g;
		eval { require $file; 1 }
			or do { push @bad, "missing $module"; next };
		$min and !eval { $module->VERSION($min); 1 }
			and push @bad, "$module: version $min required"
				. " (this is " . (defined $module->VERSION ? $module->VERSION : '?') . ")";
	}
	if (@bad) {
		print STDERR "E: $_\n" for @bad;
		die "E: " . scalar(@bad) . " module" . (@bad == 1 ? '' : 's')
			. " missing.  Looks like you got some work to do...\n";
	}
}

use Encode ();
use RdKw::I18N::CodeSets ();
use RdKw::WwW::GenGenLib qw( read_make write_make );

# How can ./configure work without siteconf -g afterwards?
# Anyways, let's just port this one function in the (very
# weird) circumstance where SiteConf.pm is somehow missing.
#
# This assumes you have a Bourne shell (/bin/sh), like the
# shell POSIX make runs its commands in.
sub shell_quote
{
	my ($s) = @_;
	# Nothing in it for the shell to mangle?  Then leave it be.
	return $s if $s =~ m!\A[A-Za-z0-9_./:@%+=,-]+\z!;
	# otherwise: single quotes, and ' itself as '\''
	$s =~ s!'!'\\''!g;
	"'$s'";
}

my (%D, %O, $reset, $shutup, $mkpath, $prog, $usage);

# -Dname=val, -Oname=val (a lone -Dname is -Dname=)
sub setter
{
	my ($S, $H) = @_;
	sub {
		my ($k, $v) = split(/=/, $_[1], 2);
		length $k or die "$prog: -$S: empty name.\n";
		$H->{$k} = defined $v ? $v : "";
	};
}

my %getopt = (
	'h|help|?' => sub { print $usage; exit 0 },
	'reset'    => sub { %D = (); %O = (); $reset = 1 },
	'q|quiet'  => \$shutup,
	'mkpath'   => \$mkpath,
	'D=s'      => setter(D => \%D),
	'O=s'      => setter(O => \%O),
);

# The code sets: as the locale says, but for what SITECONF_CODESETS
# and then -C (which must come first) say (see RdKw::I18N::CodeSets).
# `use utf8' covers our source, but not @ARGV: those arrive as bytes,
# and would be encoded a second time on their way into MY/*.mk.  So
# -C is read first, as bytes, since it says how to read the rest; then
# they are all decoded, and read for good.  What cannot be decoded is
# an error.  Console output/error is meant for humans, so what it
# cannot spell is written as ASCII \x{...}.
my $cs = RdKw::I18N::CodeSets->new;
$cs->parse_from_env('SITECONF_CODESETS', prog => 'E');
my $offset = $cs->parse_from_argv(\@ARGV, prog => 'E');
RdKw::I18N::CodeSets->locale($cs);
$cs->initstd(stdout => Encode::FB_PERLQQ(), stderr => Encode::FB_PERLQQ());

# File names, as the file system spells them, and back
sub to_fs { $cs->to_fs($_[0], { prog => 'E' }) }
sub un_fs { $cs->un_fs($_[0], { prog => 'E' }) }

# Our name came as an argument; it is only said, so it need not decode
$prog = basename($cs->un_argv($0, { check => Encode::FB_PERLQQ() }));

# Baked in by `@PROG@ -i'.
#   D   definitions, which are filesystem routing and nothing else
#   O   options, which alter the state of the build
my %Dd = (
@DDEF@
);
my %Od = (
@ODEF@
);

sub isnull
{
	!(defined $_[0]) || !(length $_[0]);
}

$usage = <<EOM;
usage: $prog [-C codeset ...] [-Dvar=val ...] [-Ovar=val ...] [--reset] [--mkpath] [-hq]

The following variables may be defined:

  -DA         Project root, seen from current directory (default: $Dd{A})
  -DB         Build directory, seen from the source tree (default: $Dd{B})
  -Da         Source directory, seen from the source tree (default: $Dd{a})
  -Db         Target directory, seen from the build directory (default: $Dd{b})
  -Dc         Cache directory, seen from the build directory (default: @{[ $Dd{c} ne $Dd{b} ? $Dd{c} : '-Db' ]})
  -DR         Transformation rules, from current directory (default: $Dd{R})
  -DF         Manifest, from current directory (default: $Dd{F})
  -De         Directory marker (default: $Dd{e})
  -Dclean     Clean rule template (default: $Dd{clean})
@DEFHELP@@OPTHELP@
Anything else you may -D or -O goes into MY/config.mk or MY/option.mk
respectively, for the rulebook or for the files being transformed.

  -C          Code sets, after SITECONF_CODESETS; first, or not at all
              (see RdKw::I18N::CodeSets)
  -h          This help message (alias: --help, -?)
  --reset     Clear all configuration at this point
  -q          Disable tips (alias: --quiet)
  --mkpath    Create non-leaf build directory components

See also `perldoc RdKw::WwW::SiteConf::Configure'.
EOM

eval { @ARGV = $cs->un_argv(@ARGV, { start => 1 + $offset }); 1 } or die "$prog: $@";
Getopt::Long::Configure(qw( bundling no_ignore_case ));
# (-C comes first, or not at all: the rest was read without it)
GetOptions(%getopt, 'C:s' => sub { die "E: too late to -C now.\n" })
	or die +( split(/^/, $usage, 2) )[0];
@ARGV and die "$prog: too many arguments\n";

# Store the starting directory: for the
# `siteconf -g' hint after configuring.
my $start = un_fs(getcwd());

# Find the source tree, which is where A says it is,
# observed from the starting directory (not necessarily
# relative to the base directory of this script).
my $A = isnull($D{A}) ? $Dd{A} : $D{A};
my $srcdir = abs_path(to_fs(File::Spec->rel2abs($A, $start)));
defined $srcdir or die "E: cannot find \$A (aka `$A'): $!\n";
$srcdir = un_fs($srcdir);
chdir to_fs($srcdir) or die "E: cannot chdir to \$A (aka `$srcdir'): $!\n";

# -DB is the build directory, seen from the source tree; like
# `cmake -B' we go there, and make it if it is not there.  Its
# spelling is kept as is -- absolute or not.  It is a statement about
# *this* run: nothing about it is ever read back from MY/config.mk,
# which is the very file it is about to choose.
my $B = isnull($D{B}) ? $Dd{B} : $D{B};
unless (-d to_fs($B)) {
	# Please do not --mkpath unless you absolutely need to.
	# This is only provided if you ABSOLUTELY depend on the
	# old behavior.  Consider running the mkdir -p equivalent
	# on your system and setting the appropriate permission
	# or ACL bits, and at MOST leave the leaf directory to
	# us to create it.
	if ($mkpath) {
		require File::Path;
		File::Path::make_path(to_fs($B), { error => \my $err });
		if (@$err) {
			my ($path, $why) = %{ $err->[0] };
			die "E: cannot create " . (length $path ? un_fs($path) : $B) . ": $why\n";
		}
	} else {
		mkdir to_fs($B) or $!{EEXIST}   # Forgive race condition...
			or die "E: cannot mkdir $B: $!" . ($!{ENOENT}
			# Provide a plausible explanation for ENOENT.
			# There might be weirder cases with symlinks,
			# but I'm not gonna investigate further lol.
			? " (missing non-leaf components?)\n"
			: "\n");
	}
}
chdir to_fs($B) or die "E: cannot chdir to \$B (aka `$B'): $!\n";
my $Babs = un_fs(getcwd());

# Files first, command line over them -- unless --reset said otherwise.
unless ($reset) {
	my %Dc = %D;   # cool times
	my %Oc = %O;   # trade anyone?
	%D = -f "MY/config.mk" && -r _ ? read_make("MY/config.mk") : ();
	# A c that was the same as b (as it was last time: no distinction
	# between build and cache, however it came to be) follows b, if b
	# is now set to something else -- unless c is explicitly set.
	$D{c} = $Dc{b} if !exists $Dc{c} && exists $Dc{b} && !isnull($D{c})
		&& !isnull($D{b}) && $D{c} eq $D{b};
	%O = -f "MY/option.mk" && -r _ ? read_make("MY/option.mk") : ();
	@D{keys %Dc} = values %Dc;
	@O{keys %Oc} = values %Oc;
}

# Set base paths according to our knowledge.
#   A  the source tree, seen from the build dir (`.' in-tree)
#   B  the build dir, seen from the source tree (`.' in-tree)
# An absolute A or B is spelled as it was given.
$D{B} = $B;
$D{A} = File::Spec->file_name_is_absolute($A) ? $A
	: File::Spec->abs2rel($srcdir, $Babs);

# Set other paths and other variables.
foreach my $k (keys %Dd) {
	next if $k eq 'c';
	$D{$k} = $Dd{$k} if isnull($D{$k});
}
foreach my $k (keys %Od) {
	$O{$k} = $Od{$k} if isnull($O{$k});
}

# If there is a preset, validate our state there.
preset_finish(\%D, \%O) if defined &preset_finish;

foreach my $k (qw( a b R F )) {
	$D{$k} =~ s!/+$!!;
	length $D{$k} or die "E: `$k' may not be empty.\n";
}
# b is a directory we create rules under, one parent at a time;
# that walk ends at `.', so it must be relative.  (a, on the
# other hand, is free to be absolute for foreign source files.)
File::Spec->file_name_is_absolute($D{b})
	and die "E: `b' prefix must be a relative path.\n";
# c, the cache: defaults to -Dc from the command-line, or
# else -Sc (but *only* if it differs from -Sc), or else b.
# It is always defined since 0.02_01, though it is opt-in.
isnull($D{c}) and $D{c} = !isnull($Dd{c}) && $Dd{c} ne $Dd{b} ? $Dd{c} : $D{b};
$D{c} =~ s!/+$!!;
length $D{c} or die "E: `c' may not be empty.\n";
# We also create rules under c, so it must be relative too.
File::Spec->file_name_is_absolute($D{c})
	and die "E: `c' prefix must be a relative path.\n";
$D{e} =~ m!/! and die "E: `e' may not contain a slash.\n";

-d 'MY' or mkdir 'MY' or die "mkdir MY: $!\n";
foreach my $f ([ config => \%D ], [ option => \%O ]) {
	my ($name, $H) = @$f;
	my $what = write_make("MY/$name.mk", $H, $prog);
	$what and print STDERR ($what > 1 ? "Writing" : "Updating"),
		" MY/$name.mk\n" unless $shutup;
}

# Compute $B for `siteconf -g', as seen from the starting directory
# (not from the source tree, which is where $D{B} is seen from);
# an absolute one is spelled as it was given, like in config.mk.
my $Bhere = File::Spec->file_name_is_absolute($B) ? $B
	: File::Spec->abs2rel($Babs, $start);
my $where = $Bhere eq '.' ? '' : " -B " . shell_quote($Bhere);
unless ($shutup) {
	print STDERR "Done!\n";
	print STDERR "To generate build script, run: @PROG@ -g$where\n";
}

exit 0;
