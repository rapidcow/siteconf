#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:110
msgid "read_make: cannot open file %q: %m"
msgstr "read_make: 无法打开文件 %q：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:117
msgid "read_make: %q line %s: no `='"
msgstr "read_make: %q 第 %s 行：没有 `='"

#. HEY!  by bad we mean the make variable name contains
#. metacharacters which should not exist in a legal name.
#. (Not your "legal name", of course, i mean a name that
#. is allowed... like IL-legal in the sense of invalid.
#. (but let's not get into the topic of identity crisis...
#. we're talking about SYNTACTICALLY invalid names here.))
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:147
msgid "write_make: bad name: %q"
msgstr "write_make: 非法变量名：%q"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:148
msgid "write_make: %q: value has a newline"
msgstr "write_make: %q：值中有换行符"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:180
msgid "update_file: cannot create file %q: %m"
msgstr "update_file: 无法创建文件 %q：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:182
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:184
msgid "update_file: cannot write file %q: %m"
msgstr "update_file: 无法写入文件 %q：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:191
msgid "update_file: cannot rename %q to %q: %m"
msgstr "update_file: 无法将 %q 重命名为 %q：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:220
msgid ""
"error: You have not configured! (no %q)\n"
"error: You should ./configure first. ;)"
msgstr ""
"error: 你还没有配置！（没有 %q）\n"
"error: 请先运行 ./configure。(⸝⸝> ᴗ•⸝⸝)"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:386
msgid "read_deps: cannot open file %q: %m"
msgstr "read_deps: 无法打开文件 %q：%m"

#. HEY!  Keep the second-person pronoun.
#. It's mildly sarcastic (with that period
#. at the end) -- imagine a "wtf" stare as
#. in... "you HAVE too many.  The hell are
#. you tryin' to be, the whole universe?"
#. Like that.
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:420
msgid "read_deps: %q line %s: You HAVE too many."
msgstr "read_deps: %q 第 %s 行：你 HAVE 太多了。(ಠ_ಠ)"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:435
msgid "read_deps: cannot read file %q: %m"
msgstr "read_deps: 无法读取文件 %q：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:581
msgid "norm_deps: %s is no code point in %q"
msgstr "norm_deps: %s 不是码位（在 %q 中）"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:593
msgid "norm_deps: trailing $ in %q"
msgstr "norm_deps: %q 末尾有多余的 $"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:595
msgid "norm_deps: unterminated or empty ${ in %q"
msgstr "norm_deps: %q 中有未闭合或为空的 ${"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:597
msgid "norm_deps: stray $ in %q"
msgstr "norm_deps: %q 中有多余的 $"

#. HEY!  "bad" means undefined in the substitution
#. map here -- think `set -u' in your Bourne shell.
#. It is technically also double entendre, since
#. the map-less version of subs_deps is used as a
#. pure decode operation... in which case a named
#. substitution that is not an escape at all as "bad"
#. as in, "wait.... that's illegal."
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:676
#, perl-format
msgid "subs_deps: bad substitution: %s"
msgstr "subs_deps: 替换错误：%s"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:107
msgid "read_manifest: cannot open string: %m"
msgstr "read_manifest: 无法打开字符串：%m"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:111
msgid "read_manifest: cannot open file %q: %m"
msgstr "read_manifest: 无法打开文件 %q：%m"

#. HEY!  %q is the file name of the faulty
#. MANIFEST and %s is its lineno.
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:118
msgid "%q line %s"
msgstr "%q 第 %s 行"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:120
#, perl-format
msgid "read_manifest: %s: not UTF-8"
msgstr "read_manifest: %s：不是 UTF-8"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:125
#, perl-format
msgid "read_manifest: %s: MAKE takes exactly one goal name"
msgstr "read_manifest: %s：MAKE 只接受一个目标名"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:129
msgid "read_manifest: %s: bad goal name %q"
msgstr "read_manifest: %s：目标名有误：%q"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:130
msgid "read_manifest: %s: goal %q is already made"
msgstr "read_manifest: %s：目标 %q 已经有了"

#. HEY!  the second %s is the string "NEED" or "WANT"
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:138
#, perl-format
msgid "read_manifest: %s: %s before any MAKE"
msgstr "read_manifest: %s：%s 出现在任何 MAKE 之前"

#. HEY!  the second %s is the string "NEED" or "WANT"
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:140
#, perl-format
msgid "read_manifest: %s: %s takes exactly one file (use # for comments)"
msgstr "read_manifest: %s：%s 只接受一个文件（注释请用 #）"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:146
#, perl-format
msgid "read_manifest: %s: %s"
msgstr "read_manifest: %s：%s"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:148
msgid "read_manifest: %s: %q is no name"
msgstr "read_manifest: %s：%q 不是名称"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:150
msgid "read_manifest: %s: %q has a NUL in it"
msgstr "read_manifest: %s：%q 中有 NUL"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:155
msgid "read_manifest: %s: expected MAKE, NEED or WANT, not %q"
msgstr "read_manifest: %s：应为 MAKE、NEED 或 WANT，而不是 %q"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:158
msgid "read_manifest: cannot read file %q: %m"
msgstr "read_manifest: 无法读取文件 %q：%m"

#. HEY!  I (ethan/rc) didn't write this message.
#. I'm frankly a bit surprised Claude made it
#. a question... anyways go wild at it i don't
#. really have any idea lol :v
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:163
msgid "read_manifest: %q: no goals; what should I make?"
msgstr "read_manifest: %q：没有目标；我该构建什么呢？"

#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:208
msgid "read_manifest: %q: no goal %q"
msgstr "read_manifest: %q：不存在目标 %q"

#. HEY!  the first %s is the class name (in every message
#. that starts so), and the second is an option name
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:188
#, perl-format
msgid "%s: %s is not supported"
msgstr "%s: 不支持 %s"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:191
#, perl-format
msgid "%s: SOURCE (the template to process) is required"
msgstr "%s: 必须给出 SOURCE（要处理的模板）"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:205
msgid "%s: ALLOW_PREFIXES: %q is not a symbolic root"
msgstr "%s: ALLOW_PREFIXES：%q 不是符号根"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:216
msgid "%s: source %q not found"
msgstr "%s: 找不到源文件 %q"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:219
msgid "%s: %q: no HAVE"
msgstr "%s: %q：没有 HAVE"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:221
msgid "%s: %q: You HAVE %q, but it is actually %s"
msgstr "%s: %q：你 HAVE %q，但它其实是 %s"

#. HEY!  the last %s is the variable, as ${name}
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:258
msgid "%s: %q: no such variable %s"
msgstr "%s: %q：没有变量 %s"

#. HEY!  a path, and how a header would name it (${a}/x)
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:308
msgid "%q (aka %q)"
msgstr "%q（又名 %q）"

#. HEY!  the first (or only) %s is a name, as "%q (aka %q)"
#. says it, and a second is an option name, as it is
#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:404
#, perl-format
msgid "undeclared dependency: %s"
msgstr "未声明的依赖：%s"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:406
#, perl-format
msgid "%s is declared, but forbidden because %s does not permit its root"
msgstr "%s 已声明，但 %s 不允许它的根，所以被禁止"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:408
#, perl-format
msgid "%s is declared, but forbidden because %s is unset"
msgstr "%s 已声明，但没有设置 %s，所以被禁止"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:413
msgid "absolute paths are not allowed (ABSOLUTE is unset)"
msgstr "不允许绝对路径（没有设置 ABSOLUTE）"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:414
msgid "relative paths are not allowed (RELATIVE is unset)"
msgstr "不允许相对路径（没有设置 RELATIVE）"

#: ../template-provider/lib/RdKw/WwW/GenGenLib/Template/Provider.pm:473
msgid "%q: not a file"
msgstr "%q：不是文件"
