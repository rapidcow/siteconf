#!perl
#
# t/diag.t - What siteconf -g says of what cannot be had: where, and in
# what order; and what the header of the build file says made it

use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/lib";

use File::Path qw( make_path );
use File::Temp qw( tempdir );
use TestPaths qw( script_path perl5lib );
use TestDiag qw( fold );
use RdKw::WwW::GenGenLib qw( write_make );

my $script = script_path();
$ENV{PERL5LIB} = perl5lib();

my $dir = tempdir(CLEANUP => 1);
make_path("$dir/MY", "$dir/html");
sub put {
	my ($name, $text) = @_;
	open my $fh, '>', "$dir/$name" or die $!;
	print $fh $text;
	close $fh or die $!;
}
sub slurp { open my $fh, '<', "$dir/$_[0]" or return ''; local $/; <$fh> }
sub run {
	open my $fh, '-|' or do {
		chdir $dir or die $!;
		open STDERR, '>&', STDOUT or die $!;
		exec $^X, $script, @_;
		die "exec: $!";
	};
	my $out = do { local $/; <$fh> };
	close $fh;
	($? >> 8, $out);
}

# The page that `core' NEEDs WANTs the art, which two goals NEED, and
# which NEEDs a file that is not there
put('MANIFEST', <<'M');
MAKE site
	NEED core
	WANT media
	WANT more
MAKE core
	NEED page.html
MAKE media
	NEED art.gif
MAKE more
	NEED art.gif
M
put('Makefile.in', <<'R');
page.html:
	cp ${a}/${@} ${b}/${@}
art.gif: ${A}/gone.png
	cp ${A}/gone.png ${b}/${@}
R
put('html/art.gif', '');
put('html/page.html', "# WANT: \${B}/\${b}/art.gif\n");
write_make("$dir/MY/config.mk", {
	A => '.', B => '.', a => 'html', b => 'site', c => 'site', e => '.ok',
	F => 'MANIFEST', R => 'Makefile.in',
}, prog => 'test');

my ($status, $out) = run('-g', '-Sclean', '-Sorder=1', '-o', 'Other.mk');
is($status, 0, 'a WANTed goal that cannot be had is no failure') or diag $out;
$out =~ s/^(?!W:).*\n//mg;
is($out, <<'W', 'what cannot be had comes before what goes without it; each said once, where it was said');
W: -Sorder=1: unused by generator make
W: goal `site' WANTs `art.gif'
W:  (in MANIFEST line 8, via WANTed goal `media'),
W:   but cannot be made:
W:   NEEDs `gone.png'
W:    (prerequisite in Makefile.in line 3),
W:     which we don't seem to have.
W: target `page.html' WANTs `site/art.gif'
W:  (in header of `html/page.html' line 1),
W:   but it is missing; going on without it. :(
W
is(fold($out), <<'W', '... a sentence a line, once folded (as the other tests have it)');
W: -Sorder=1: unused by generator make
W: goal `site' WANTs `art.gif' (in MANIFEST line 8, via WANTed goal `media'), but cannot be made:
W:   NEEDs `gone.png' (prerequisite in Makefile.in line 3), which we don't seem to have.
W: target `page.html' WANTs `site/art.gif' (in header of `html/page.html' line 1), but it is missing; going on without it.
W

my $head = (slurp('Other.mk') =~ /\A((?:#.*\n)*)/)[0];
is($head, <<'H', 'the header says what made it, with -S and without -o');
#
# Makefile!
# (generated by `siteconf -g' :D)
#
# options: -G make -S clean -S order=1
#
H

# A goal that NEEDs it says the goal whose line it is, as NEEDed
put('MANIFEST', "MAKE site\n\tNEED media\nMAKE media\n\tNEED art.gif\n");
($status, $out) = run('-g', '-q');
isnt($status, 0, 'a NEEDed goal that cannot be had is a failure');
like($out, qr/^E: goal `site' NEEDs `art\.gif'\nE:  \(in MANIFEST line 4, via NEEDed goal `media'\),\n/m,
	'... and says the line, and the goal it is in');

done_testing;
