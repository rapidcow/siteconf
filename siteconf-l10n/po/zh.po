#: ../siteconf/script/siteconf:406 ../siteconf/share/configure.in:156
#: ../siteconf/share/presets/tem.render:60
#: ../siteconf/share/presets/web.render:70
#, perl-format
msgid "usage: %s"
msgstr "用法：%s"

#. HEY!  %s is the option, -D or -O.
#: ../siteconf/script/siteconf:443 ../siteconf/share/configure.in:176
#, perl-format
msgid "%s: empty name."
msgstr "%s：名字为空。"

#: ../siteconf/script/siteconf:471 ../siteconf/share/configure.in:191
#: ../siteconf/share/presets/tem.render:57
#: ../siteconf/share/presets/web.render:67
msgid "too late to -C now."
msgstr "现在给 -C 已经太晚了。"

#: ../siteconf/script/siteconf:541
#, perl-format
msgid "conflicting modes: %s and %s"
msgstr "模式冲突：%s 和 %s"

#: ../siteconf/script/siteconf:545 ../siteconf/share/configure.in:193
msgid "too many arguments"
msgstr "参数太多"

#: ../siteconf/script/siteconf:553
msgid "named outputs are only for init"
msgstr "命名的输出只适用于 init"

#: ../siteconf/script/siteconf:555
msgid "unknown output name: %q"
msgstr "未知的输出名：%q"

#: ../siteconf/script/siteconf:557
msgid "empty output path"
msgstr "输出路径为空"

#: ../siteconf/script/siteconf:566
#, perl-format
msgid "option %s is not permitted in mode %s"
msgstr "选项 %s 不能用于模式 %s"

#: ../siteconf/script/siteconf:620
msgid "missing soft dependencies and -A was requested."
msgstr "缺少软依赖，而且指定了 -A。"

#: ../siteconf/script/siteconf:644
msgid "%#q: not a valid ASCII octal code point"
msgstr "%#q：不是有效的 ASCII 八进制码位"

#: ../siteconf/script/siteconf:659 ../siteconf/lib/RdKw/WwW/SiteConf.pm:1831
msgid "%q: expected NEED or WANT, not %q"
msgstr "%q：应为 NEED 或 WANT，而不是 %q"

#. HEY!  the %s is the separator, as the option that
#. says it: -0 for a NUL, -012 for a newline
#: ../siteconf/script/siteconf:668
msgid "%q: %q conflicts with record separator %s"
msgstr "%q：%q 中有记录分隔符（%s）"

#: ../siteconf/script/siteconf:671 ../siteconf/script/siteconf:676
msgid "cannot write to stdout: %m"
msgstr "无法写入标准输出：%m"

#: ../siteconf/script/siteconf:688
msgid "cannot find %q (is WwW-SiteConf installed?)"
msgstr "找不到 %q（WwW-SiteConf 安装了吗？）"

#: ../siteconf/script/siteconf:697 ../siteconf/lib/RdKw/WwW/SiteConf.pm:1231
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:130
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:592
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:141
msgid "cannot open file %q: %m"
msgstr "无法打开文件 %q：%m"

#: ../siteconf/script/siteconf:699 ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:641
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:205
msgid "cannot read file %q: %m"
msgstr "无法读取文件 %q：%m"

#: ../siteconf/script/siteconf:753
msgid "Host-relative base URL"
msgstr "相对于主机的基础 URL"

#: ../siteconf/script/siteconf:754
msgid "Absolute base URL"
msgstr "绝对基础 URL"

#: ../siteconf/script/siteconf:759
#, perl-format
msgid "%s: no such thing (valid: %s)"
msgstr "%s：没有这一项（有效的有：%s）"

#: ../siteconf/script/siteconf:763 ../siteconf/script/siteconf:787
#, perl-format
msgid "%s may not be empty."
msgstr "%s 不能为空。"

#: ../siteconf/script/siteconf:767 ../siteconf/script/siteconf:772
#, perl-format
msgid "%s must be a relative path."
msgstr "%s 必须是相对路径。"

#: ../siteconf/script/siteconf:778
#, perl-format
msgid "%s and %s are the same thing; pick one."
msgstr "%s 和 %s 是同一回事；请选一个。"

#: ../siteconf/script/siteconf:795
msgid "bad preset name: %q"
msgstr "预设名有误：%q"

#: ../siteconf/script/siteconf:798
msgid "no such preset: %q"
msgstr "没有这个预设：%q"

#: ../siteconf/script/siteconf:816
#, perl-format
msgid "%s: bad module name"
msgstr "%s：模块名有误"

#: ../siteconf/script/siteconf:819
#, perl-format
msgid "%s: no version for what is dropped"
msgstr "%s：去掉的模块不能带版本"

#: ../siteconf/script/siteconf:823
#, perl-format
msgid "%s: bad version"
msgstr "%s：版本有误"

#: ../siteconf/script/siteconf:827
#, perl-format
msgid "%s: configure always needs it"
msgstr "%s：configure 总是需要它"

#: ../siteconf/script/siteconf:832
#, perl-format
msgid "%s: version %s or later is required"
msgstr "%s：需要版本 %s 或更高版本"

#: ../siteconf/script/siteconf:849
msgid "preset does not supply a render output"
msgstr "该预设不提供 render 输出"

#: ../siteconf/script/siteconf:892
msgid "Not changing %#q"
msgstr "不更改 %#q"

#: ../siteconf/script/siteconf:898
msgid "cannot remove %q: %m"
msgstr "无法删除 %q：%m"

#: ../siteconf/script/siteconf:911 ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:365
msgid "cannot create file %q: %m"
msgstr "无法创建文件 %q：%m"

#: ../siteconf/script/siteconf:914 ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:368
#: ../gengenlib/lib/RdKw/WwW/GenGenLib.pm:371
msgid "cannot write file %q: %m"
msgstr "无法写入文件 %q：%m"

#: ../siteconf/script/siteconf:917
msgid "cannot chmod %q: %m"
msgstr "无法修改 %q 的权限：%m"

#. HEY!  "Overwrote" clobbers a file the user
#. explicitly lets us with -f, and "wrote" means
#. the file is simply created.  I don't know why
#. Claude felt the need to clarify this; this
#. seems pretty clear to me. :/
#: ../siteconf/script/siteconf:927
msgid "Overwrote %#q"
msgstr "已覆盖 %#q"

#: ../siteconf/script/siteconf:927
msgid "Wrote %#q"
msgstr "已写入 %#q"

#: ../siteconf/script/siteconf:932
msgid "You already have configure."
msgstr "你已经有 configure 了。"

#: ../siteconf/script/siteconf:933
msgid "You already have configure at %q."
msgstr "你已经在 %q 有 configure 了。"

#: ../siteconf/script/siteconf:935
msgid ""
"Pass -o /dev/null if you did mean to not generate configure,\n"
"or -f to overwrite the existing one."
msgstr ""
"如果你确实不想生成 configure，请传 -o /dev/null；\n"
"要覆盖现有的，请传 -f。"

#. HEY!  %#q is the file name of the faulty
#. file and %d is its lineno.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:421
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:123
msgid "%#q line %d"
msgstr "%#q 行 %d"

#. HEY!  Keep a winky face in the translation ;)
#. (as GenGenLib's load_state does: newbies see it)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:504
msgid ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"
msgstr ""
"你还没有配置！（没有 %q）\n"
"请先运行 ./configure。(⸝⸝> ᴗ•⸝⸝)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:521
msgid "%q: %q is missing.  Try reconfiguring."
msgstr "%q：缺少 %q。请尝试重新配置。"

#. HEY!  %q is a variable of config.mk: `b' or `c', which are where
#. what we make goes (the target tree, and the cache)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:527
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:532
msgid "%q prefix must be a relative path."
msgstr "%q 前缀必须是相对路径。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:535
msgid "%q prefix may not climb out of the build directory."
msgstr "%q 前缀不能跑出构建目录。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:538
msgid "%q (directory marker) may not contain a slash."
msgstr "%q（目录标记）不能含有斜杠。"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:541
msgid "%q may be made of letters, digits and -_.+& only: %q"
msgstr "%q 只能由字母、数字和 -_.+& 组成：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:549
msgid "cannot find the build directory %q: %m"
msgstr "找不到构建目录 %q：%m"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:552
msgid "cannot find the source tree %q: %m"
msgstr "找不到源代码树 %q：%m"

#. HEY!  The first %s is where (a file, or `file' line 3), and
#. the second is b or c (a variable of config.mk, as in ${b}).
#. Leave the ${...}s alone: they are what is written in a header.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:657
#, perl-brace-format
msgid "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."
msgstr "%1$s：%2$q：${%3$s} 是相对于 ${B} 的；请写 ${B}/${%3$s}。"

#. HEY!  the last %s is what is in a header, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:678
msgid "%s: %q: %s is no code point"
msgstr "%s：%#q：%s 不是码位"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:685
msgid "%s: %q: no such variable %s"
msgstr "%s：%#q：没有变量 %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:689
msgid "%s: stray $ in %q"
msgstr "%s：%q 中有多余的 $"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:694
#, perl-format
msgid "%s: empty path"
msgstr "%s：路径为空"

#. HEY!  The first %s is where (as in the messages above), %s
#. the character (U+0041) and %s its spelling in bytes (0x5C).
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:802
#, perl-format
msgid ""
"%s: %s is spelled by the file system as %s, which has a byte of ASCII that "
"is special"
msgstr ""

#. HEY!  The first %s is always where (a file, or `file' line 3),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:858
msgid "%s: bad file name %q"
msgstr "%s：文件名有误：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:862
msgid "%s: file name %q must be relative"
msgstr "%s：文件名 %q 必须是相对的"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:865
msgid "%s: file name %q is out of tree"
msgstr "%s：文件名 %q 在树外"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:918
msgid "%s: %q is a reserved goal name"
msgstr "%s：%q 是保留的目标名"

#. HEY!  the second %s is a chain of goals, as `a -> b -> a'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:944
#, perl-format
msgid "%s: goals that need themselves: %s"
msgstr ""

#. HEY!  the second %s is a string literal, as ${"..."}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1035
#, perl-format
msgid "%s: junk after the string in %s"
msgstr ""

#. HEY!  the second %s is what is in Makefile.in, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1057
#, perl-format
msgid "%s: %s is not a valid Unicode code point"
msgstr "%s：%s 不是有效的 Unicode 码位"

#. HEY!  the second %s is a variable, as ${@} (or ${.TARGET}),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1064
#, perl-format
msgid "%s: %s outside of a recipe"
msgstr "%s：%s 出现在配方之外"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1069
#, perl-format
msgid "%s: misplaced %s (not in a recipe)"
msgstr "%s：%s 放错了地方（不在配方中）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1072
#, perl-format, perl-brace-format
msgid "%s: undefined %s (explicitly suppressed by ${a})"
msgstr "%s：%s 未定义（被 ${a} 显式取消了）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1079
#, perl-format
msgid "%s: undefined variable: %s"
msgstr "%s：未定义的变量：%s"

#. HEY!  the second %s is where, as `a prerequisite'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1091
#, perl-format
msgid ":Q (shell quote) is not valid in %s"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1092
#, fuzzy
msgid "a name"
msgstr "名称有误：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1093
msgid ":Q (shell quote) must be the last modifier"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1098
msgid "a nested expansion"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1124
#, fuzzy
msgid "a prerequisite"
msgstr "%s 中的先决条件"

#. HEY!  The first %s is where, the second what is in Makefile.in
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1128
msgid "%s: %q expands to nothing"
msgstr "%s：%q 展开后为空"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1157
#, perl-brace-format
msgid "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"
msgstr "%s：%#q：目标前面没有合法的前缀（${b} 或 ${c}）"

#. HEY!  the second %s is a variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1195
#, fuzzy, perl-format
msgid "%s: %s is already defined"
msgstr "%s：目标 %q 已经有了"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1211
msgid "a variable assignment"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1262
#, perl-format
msgid "%s: unfinished line continuation"
msgstr "%s：续行没有结束"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1274
msgid "%s: more than one recipe for %q"
msgstr "%s：%q 有不止一个配方"

#. HEY!  a recipe line (one that begins with a tab)
#. with no rule above it to be the recipe of
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1286
#, perl-format
msgid "%s: unexpected tabulation"
msgstr "%s：意外的制表符"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1303
#, perl-format
msgid "%s: null target list"
msgstr "%s：目标列表为空"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1333
#, fuzzy
msgid ""
"%s: %q: a prerequisite must start with NEED:, WANT:, JUST: (or JUST-NEED:) "
"or JUST-WANT:, not %q"
msgstr "%s：%#q：先决条件必须以 `NEED:' 或 `WANT:' 开头，而不是 %q"

#. HEY!  %q is `NEED:' or `WANT:', literally.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1338
msgid "%s: %q something?"
msgstr "%s：%q 什么呢？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1358
msgid "%s: invalid line: %q"
msgstr "%s：无效的行：%q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1385
msgid "somewhere"
msgstr ""

#. HEY!  %s is the files, as `a' -> `b' -> `a'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1392
#, perl-format
msgid "dependency cycle: %s"
msgstr "依赖循环：%s"

#. HEY!  the first %s is where it is JUST (as `in header of x'),
#. and the second where it is not
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1401
msgid ""
"%q is a JUST-NEED or JUST-WANT (%s), but a NEED or WANT (%s): its header "
"cannot be both read and not"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1417
msgid "%q: %q is reserved for directory markers. (Set -De to change it.)"
msgstr "%q：%q 是保留给目录标记的。（要改的话请设置 -De。）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1440
msgid "no rule to make it (%q)"
msgstr "没有生成它的规则（%q）"

#. HEY!  the %s is where the rule is (e.g. `file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1446
msgid "source %q is missing (rule at %s)"
msgstr "缺少源文件 %q（规则在 %s）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1447
msgid "source %q is missing"
msgstr "缺少源文件 %q"

#. HEY!  Keep the question mark: we are as puzzled as
#. anyone.  The (aka %q) is what the HAVE says, expanded
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1462
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q?"
msgstr ""
"%#q：你 HAVE %q（又名 %q），\n"
"但我需要的是 %q？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1464
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q?"
msgstr ""
"%#q：你 HAVE %q，\n"
"但我需要的是 %q？"

#. HEY!  This and the next three are where a NEED (or a WANT)
#. was said, and are said in parentheses after what is needed
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1471
msgid "in header"
msgstr "在头部中"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1471
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1673
msgid "in header of %q"
msgstr "在 %q 的头部中"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1476
#, perl-format
msgid "prerequisite in %s"
msgstr "%s 中的先决条件"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1477
#, perl-format
msgid "WANT: in %s"
msgstr "%s 中的 WANT:"

#. HEY!  %s is where it was needed (in header of `file').
#. The same goes for the next two marked strings.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1543
msgid "NEEDs %q (%s), but cannot be made:"
msgstr "NEED %q（%s），但它无法生成："

#. HEY!  The last %q is the name it may have meant: a
#. header says MY/option.mk, when it is ${B}/MY/option.mk
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1555
msgid "NEEDs %q (%s), which we don't seem to have (is it %q?)"
msgstr "NEED %q（%s），但我们似乎没有它（是 %q 吗？）"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1557
msgid "NEEDs %q (%s), which we don't seem to have"
msgstr "NEED %q（%s），但我们似乎没有它"

#. HEY!  The %s, in parentheses, is where it
#. was wanted (in header of `file').  The face
#. is yours to keep; i added it because "W"
#. felt like a weak indication of a soft dep
#. failing....
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1573
msgid ""
"target %q WANTs %q\n"
"  (%s)\n"
"... but it is missing; going on without it :("
msgstr ""
"目标 %q WANT %q\n"
"  （%s）\n"
"但它不存在，只好没有它继续下去... ( ˶•ᴖ•)"

#. HEY!  As above, for a tool of the rule; the last %s
#. is where the rule is (`file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1665
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%1$#q：你 HAVE %2$q（又名 %3$q），\n"
"但 %5$q 的规则（%6$s）需要的是 %4$q？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1668
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%1$#q：你 HAVE %2$q，\n"
"但 %4$q 的规则（%5$s）需要的是 %3$q？"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1724
#, fuzzy, perl-format
msgid "in the manifest, %s"
msgstr "read_manifest: %s：%s"

#. HEY!  the %s is where (`file' line 3); what
#. follows the colon is why, a line each
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1738
msgid "%s: goal %q NEEDs %q, but cannot be made:"
msgstr "%s：目标 %q NEED %q，但它无法生成："

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1743
msgid "goal %q WANTs %q, but cannot be made:"
msgstr "目标 %q WANT %q，但它无法生成："

#. HEY!  "no soup for you!" (Seinfeld) but with Makefile
#. (not my bit, Claude came up with this... but cool
#. nonetheless o_o)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1759
#, perl-format
msgid "%d problem; no Makefile for you."
msgid_plural "%d problems; no Makefile for you."
msgstr[0] "%d 个问题；不给你 Makefile。"

#. HEY!  the first %s is a name that is of a goal (or a
#. cleaning rule), and the second the file (it may be spelled
#. in other bytes: the file system and the arguments can differ)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1803
msgid "%q is the name of a rule, and a file (%q) is as well"
msgstr ""

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1833
msgid "%q: expected a goal name"
msgstr "%q：应为目标名"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1834
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:256
msgid "%#q: missing goal %q"
msgstr "%#q：缺少目标 %q"

#. HEY!  %s is the option, as in -Dclean=clean-&
