
# The `web' preset: Template Toolkit static site generator.
#
# The render script requires Template and GenLib for locate
# and file2uri (pin GenLib=0.0203 for the old buggy location
# as the Unicode file name).  At configure-time, parse_base
# from GenLib is required for validating and initializing
# site_url and base_url.
#
# USE: RdKw::WwW::GenLib=0.0300
# USE: Template
#
# These dependencies are hints for `siteconf -i'.  You may
# require a different version with `-MFoo=123', or remove it
# with `-MFoo=', and those will be the effective dependency
# of your configure script.  (Since siteconf 0.03, you can
# also use the more perl-ish `-M-Foo' to remove dependency.)
#
sub preset_finish
{
	my ($D, $O) = @_;
	isnull($O->{base_url}) and $O->{base_url} = '/';
	isnull($O->{site_url})
		and die status 0, $cs->tagmsg(E => $cs->diag(__(
		"missing %q option"), 'site_url'));
	eval { RdKw::WwW::GenLib::parse_base($O); 1 }
		or die $cs->tagmsg(E => $@);
}
