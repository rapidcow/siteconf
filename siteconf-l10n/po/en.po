#, perl-format
msgid "%s: %s outside of a recipe"
msgstr "%s: %s outside of a recipe"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:690
#, perl-format
msgid "%s: %s is not known here (the source is what the prerequisites say)"
msgstr "%s: %s is not known here (the source is what the prerequisites say)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:692
#, perl-format, perl-brace-format
