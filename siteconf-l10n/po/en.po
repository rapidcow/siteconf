msgstr "%s: %s: this rule has no source (its first prerequisite is ${a})"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:698
#, perl-format
msgid "%s: undefined variable: %s"
msgstr "%s: undefined variable: %s"

