#!/usr/bin/env perl
#
# configure -- written by `@PROG@ -i' version @VERSION@.
#
@ARGS@
use utf8;
use 5.008;
use strict;
use warnings;

use Cwd qw( getcwd abs_path );
use Encode ();
use File::Basename qw( basename );
use File::Spec;
use FindBin;
use Getopt::Long qw( GetOptions );

# siteconf 0.03 does not support Unicode-less
# GenGenLib.pm, so this is a hard requirement.
use RdKw::WwW::GenGenLib 0.0100 qw( read_make write_make );

# Initialize locale and gettext.
use RdKw::I18N::CodeSets ();
use RdKw::L10N::TextDomain ':module' => 'RdKw::WwW::SiteConf::L10N';

my ($cs, $me, $offset, $prog);

BEGIN {
	$cs = RdKw::I18N::CodeSets->locale;
	$me = basename($0);

	$cs->parse_from_env('SITECONF_CODESETS', prog => $me);
	$offset = $cs->parse_from_argv(\@ARGV, prog => $me);
	$cs->initstd( stderr => Encode::FB_PERLQQ() );
}

$prog = basename($cs->un_argv($0, { check => Encode::FB_PERLQQ() }));

# Module requirements: [ module, minimum version ]
our @NEED;
BEGIN {
	@NEED = (
@MODULES@
	);
}
@PRESET@
BEGIN {
	my @bad;
	foreach my $need (@NEED) {
		my ($module, $min) = @$need;
		(my $file = "$module.pm") =~ s!::!/!g;
		unless (eval { require $file; 1 }) {
			push @bad, $cs->diag(__("missing %s"), $module);
			next;
		}
		unless (!$min || eval { $module->VERSION($min); 1 }) {
			push @bad, $cs->diag(__("%s: version %s required (this is %s)"),
				$module, $min,
				defined $module->VERSION ? $module->VERSION : '?');
		}
	}
	if (@bad) {
		print STDERR $cs->tagmsg(E => $_) for @bad;
		my $count = @bad;
		die $cs->tagmsg(E => $cs->diag(__n(
			"%d module missing.  Looks like you got some work to do...",
			"%d modules missing.  Looks like you got some work to do...",
			$count), $count));
	}
}

sub to_fs { $cs->to_fs(@_, { prog => $prog }) }
sub un_fs { $cs->un_fs(@_, { prog => $prog }) }

# Quotes for POSIX shell (/bin/sh).
# Ported from SiteConf.pm.
sub shell_quote
{
	my ($s) = @_;
	# Nothing to mangle for the shell?  Then leave it be.
	return $s if $s =~ m!\A[A-Za-z0-9_./:@%+=,-]+\z!;
	# Otherwise: single quotes, and ' itself as '\''
	$s =~ s!'!'\\''!g;
	"'$s'";
}

# This defines the notion of "null string", so
# defaults can work like ${var:-${var_default}}.
sub isnull
{
	!(defined $_[0]) || !(length $_[0]);
}

# Defaults set by `@PROG@ -i' for:
#   %D  definitions, mostly of filesystem routing
#   %O  options, which alter the state of the build
our %Dd = (
@DDEF@
);
our %Od = (
@ODEF@
);

# Help text: [ flag, description, default ]
# The default is deferred in a lambda for some reason.
our @VARHELP = (
	[ '-DA', N__('Project root, seen from current directory'), sub { $Dd{A} } ],
	[ '-DB', N__('Build directory, seen from the source tree'), sub { $Dd{B} } ],
	[ '-Da', N__('Source directory, seen from the source tree'), sub { $Dd{a} } ],
	[ '-Db', N__('Target directory, seen from the build directory'), sub { $Dd{b} } ],
	[ '-Dc', N__('Cache directory, seen from the build directory'),
		sub { $Dd{c} ne $Dd{b} ? $Dd{c} : '-Db' } ],
	[ '-DR', N__('Transformation rules, from current directory'), sub { $Dd{R} } ],
	[ '-DF', N__('Manifest, from current directory'), sub { $Dd{F} } ],
	[ '-De', N__('Directory marker'), sub { $Dd{e} } ],
@DEFHELP@);
our @OPTHELP = (
@OPTHELP@);
our @FLAGHELP = (
	[ '-C', N__("Code sets overrides (see I18N::CodeSets)") ],
	[ '-h', N__('This help message'), undef, '--help, -?' ],
	[ '--reset', N__('Clear all configuration at this point') ],
	[ '-q', N__('Disable tips'), undef, '--quiet' ],
);

sub section
{
	my ($w, @row) = @_;
	my $text = '';
	for (@row) {
		my ($syntax, $msgid, $default, $alias) = @$_;
		my @line = split /\n/, length $msgid ? __($msgid) : '';
		@line or @line = ('');
		if ($default) {
			my $last = pop @line;
			push @line, length $last
				? $cs->diag(__("%s (default: %s)"), $last, $default->())
				: $cs->diag(__("(default: %s)"), $default->());
		}
		if (defined $alias) {
			my $last = pop @line;
			push @line, $cs->diag(__("%s (alias: %s)"), $last, $alias);
		}
		$text .= sprintf("  %-*s %s\n", $w, $syntax, shift @line);
		$text .= ' ' x ($w + 3) . "$_\n" for @line;
	}
	$text =~ s/ +$//mg;
	$text;
}

my $usage = do {
	# Don't make it wider than 12 columns (including space).
	# My screen isn't that wide; make it wider if yours is...
	my $w = 11;
	$cs->diag(__("usage: %s"), $cs->diag("%#q %s", $prog =>
		  '[-C codeset ...] [-Dvar=val ...] [-Ovar=val ...] [--reset] [-hq]'))
	. "\n\n" . __("The following variables may be defined:") . "\n\n"
	. section($w, @VARHELP)
	. (@OPTHELP ? "\n" . __("Options with defaults:") . "\n\n" . section($w, @OPTHELP) : '')
	. "\n" . __("Anything else you may -D or -O goes into MY/config.mk or MY/option.mk\n"
		. "respectively, for the rulebook or for the files being transformed.") . "\n"
	. "\n" . section($w, @FLAGHELP)
	. "\n" . __("See also WwW::SiteConf::Configure.") . "\n";
};

# Parse key-value options (-Dname=val, -Oname=val).
# Lone -Dname / -Oname is parsed as { name => undef }.
sub setter
{
	my ($S, $H) = @_;
	sub {
		my ($k, $v) = split(/=/, $_[1], 2);
		length $k or die $cs->tagmsg($prog =>
			# HEY!  %s is the option, -D or -O.
			$cs->diag(__("%s: empty name."), "-$S"));
		$H->{$k} = $v;
	};
}

my (%D, %O, $reset, $shutup);
@ARGV = $cs->un_argv(@ARGV, { start => 1 + $offset, prog => $prog });
Getopt::Long::Configure(qw( bundling no_ignore_case ));
GetOptions(
	'h|help|?' => sub { print $usage; exit 0 },
	'reset'    => sub { %D = (); %O = (); $reset = 1 },
	'q|quiet'  => \$shutup,
	'D=s'      => setter(D => \%D),
	'O=s'      => setter(O => \%O),
	# Reject misplaced -C arguments
	'C:s' => sub { die $cs->diag("%#q: %s\n", $prog, __("too late to -C now.")); })
	or die +( split(/(?<=\n)\n/m, $usage) )[0];
@ARGV and die $cs->diag("%#q: %s\n", $prog, __("too many arguments"));

# Store the starting directory: for the
# `siteconf -g' hint after configuring.
my $start = un_fs(getcwd());

# Find the source tree, which is where ${A} says it is,
# observed from the starting directory (not necessarily
# relative to the base directory of this script).
my $A = isnull($D{A}) ? $Dd{A} : $D{A};
my $Adir = abs_path(to_fs(File::Spec->rel2abs($A, $start)));
defined $Adir or die $cs->tagmsg(E => $cs->diag(__(
	'cannot find ${A} (aka %q): %m'), $A));
$Adir = un_fs($Adir);
chdir to_fs($Adir) or die $cs->tagmsg(E => $cs->diag(__(
	'cannot chdir to ${A} (aka %q): %m'), $Adir));

# ${B} is the build directory, seen from the source tree,
# like `cmake -B'.  Determine it now from the command-line
# or the configured defaults so we know where MY/*.mk are.
# Like ${A}, we assume this path already exists.
my $B = isnull($D{B}) ? $Dd{B} : $D{B};
chdir to_fs($B) or die $cs->tagmsg(E => $cs->diag(__(
	'cannot chdir to ${B} (aka %q): %m'), $B));
my $Bdir = un_fs(getcwd());

# Configs and options inherit from ${B}/MY/*.mk UNLESS
# they have been --reset at least once, in which case
# the %D and %O now are fine and don't require merging.
unless ($reset) {
	my %Dc = %D;
	my %Oc = %O;
	%D = -f "MY/config.mk" && -r _
		? read_make("MY/config.mk", prog => $prog)
		: ();
	# A ${c} that is read the same as ${b} is
	# considered to be ``sticky'' and follows
	# ${b} unless explicitly overridden via -Dc.
	$D{c} = $Dc{b} if !exists $Dc{c} && exists $Dc{b}
		&& !isnull($D{c}) && !isnull($D{b}) && $D{c} eq $D{b};
	%O = -f "MY/option.mk" && -r _
		? read_make("MY/option.mk", prog => $prog)
		: ();
	@D{keys %Dc} = values %Dc;
	@O{keys %Oc} = values %Oc;
}

# Set base paths according to our knowledge.
#   ${A}  the source tree, seen from the build dir (`.' in-tree)
#   ${B}  the build dir, seen from the source tree (`.' in-tree)
# An absolute ${A} or ${B} is spelled as it was given.
$D{B} = $B;
$D{A} = File::Spec->file_name_is_absolute($A)
	? $A : File::Spec->abs2rel($Adir, $Bdir);

# Set other paths and other variables.
foreach my $k (keys %Dd) {
	next if $k eq 'c';
	$D{$k} = $Dd{$k} if isnull($D{$k});
}
foreach my $k (keys %Od) {
	$O{$k} = $Od{$k} if isnull($O{$k});
}

# If there is a preset, validate our state there.
preset_finish(\%D, \%O) if defined &preset_finish;

foreach my $k (qw( a b R F )) {
	$D{$k} =~ s!/+$!!;
	length $D{$k} or die $cs->tagmsg(E => $cs->diag(__(
		'${%s} may not be empty.'), $k));
}
# ${b} is a directory we create rules under, one parent at a time;
# that walk ends at `.', so it must be relative.  (${a}, on the
# other hand, is free to be absolute for foreign source files.)
File::Spec->file_name_is_absolute($D{b})
	and die $cs->tagmsg(E => $cs->diag(__(
	'${%s} prefix must be a relative path.'), 'b'));
# ${c}, the cache: defaults to -Dc from the command-line, or
# else -Sc (but *only* if it differs from -Sb), or else ${b}.
# It is always defined since 0.02_01, though it is opt-in.
isnull($D{c}) and $D{c} = !isnull($Dd{c})
	&& $Dd{c} ne $Dd{b} ? $Dd{c} : $D{b};
$D{c} =~ s!/+$!!;
length $D{c} or die $cs->tagmsg(E => $cs->diag(__(
	'${%s} may not be empty.'), 'c'));
# We also create rules under ${c}, so it must be relative too.
File::Spec->file_name_is_absolute($D{c})
	and die $cs->tagmsg(E => $cs->diag(__(
	'${%s} prefix must be a relative path.'), 'c'));
$D{e} =~ m!/! and $cs->tagmsg(E => $cs->diag(__(
	'${%s} may not contain a slash.'), 'e'));

-d 'MY' or mkdir 'MY' or die $cs->tagmsg(E => $cs->diag(__(
	"cannot mkdir %q: %m"), 'MY'));
foreach my $f ([ config => \%D ], [ option => \%O ]) {
	my ($name, $H) = @$f;
	my $what = write_make("MY/$name.mk", $H, prog => $prog);
	$what and print STDERR $cs->diag(
		$what > 1 ? __("Writing %#q") : __("Updating %#q"),
		"MY/$name.mk"), "\n" unless $shutup;
}

# Compute $B for `siteconf -g', as seen from the starting directory
# (not from the source tree, which is where $D{B} is seen from);
# an absolute one is spelled as it was given, like in config.mk.
my $Brel = File::Spec->file_name_is_absolute($B)
	? $B : File::Spec->abs2rel($Bdir, $start);
my $Bcmd = $Brel eq '.' ? '' : " -B " . shell_quote($Brel);
unless ($shutup) {
	print STDERR __("Done!"), "\n";
	print STDERR $cs->diag(__(
		# HEY!  %s is a command.
		"To generate build script, run: %s"),
		"@PROG@ -g$Bcmd"), "\n";
}

exit 0;
