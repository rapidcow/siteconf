msgid "cannot chmod %q: %m"
msgstr "cannot chmod %q: %m"

#. HEY!  "Overwrote" clobbers a file the user
#. explicitly lets us with -f, and "wrote" means
#. the file is simply created.  I don't know why
#. Claude felt the need to clarify this; this
#. seems pretty clear to me. :/
#: ../siteconf/script/siteconf:1083
msgid "Overwrote %#q"
msgstr "Overwrote %#q"

#: ../siteconf/script/siteconf:1083
msgid "Wrote %#q"
msgstr "Wrote %#q"

#: ../siteconf/script/siteconf:1088
msgid "You already have configure."
msgstr "You already have configure."

#: ../siteconf/script/siteconf:1089
msgid "You already have configure at %q."
msgstr "You already have configure at %q."

#: ../siteconf/script/siteconf:1091
msgid ""
"Pass -o /dev/null if you did mean to not generate configure,\n"
"or -f to overwrite the existing one."
msgstr ""
"Pass -o /dev/null if you did mean to not generate configure,\n"
"or -f to overwrite the existing one."

#. HEY!  %#q is the file name of the faulty
#. file and %d is its lineno.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:437
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:141
msgid "%#q line %d"
msgstr "%#q line %d"

#. HEY!  Keep a winky face in the translation ;)
#. (as GenGenLib's load_state does: newbies see it)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:529
msgid ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"
msgstr ""
"You have not configured!  (no %q)\n"
"You should ./configure first. ;)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:544
msgid "%q: %q is missing.  Try reconfiguring."
msgstr "%q: %q is missing.  Try reconfiguring."

#. HEY!  %q is a variable of config.mk: `b' or `c', which are where
#. what we make goes (the target tree, and the cache)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:550
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:555
msgid "%q prefix must be a relative path."
msgstr "%q prefix must be a relative path."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:558
msgid "%q prefix may not climb out of the build directory."
msgstr "%q prefix may not climb out of the build directory."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:561
msgid "%q (directory marker) may not contain a slash."
msgstr "%q (directory marker) may not contain a slash."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:568
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1103
msgid "cannot find the build directory %q: %m"
msgstr "cannot find the build directory %q: %m"

#. HEY!  The first %s is where (a file, or `file' line 3), and
#. the second is b or c (a variable of config.mk, as in ${b}).
#. Leave the ${...}s alone: they are what is written in a header.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:686
#, perl-brace-format
msgid "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."
msgstr "%1$s: %2$q: ${%3$s} is relative to ${B}; use ${B}/${%3$s}."

#. HEY!  the last %s is what is in a header, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:707
msgid "%s: %q: %s is no code point"
msgstr "%s: %q: %s is no code point"

#. HEY!  the last %s is the variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:714
msgid "%s: %q: no such variable %s"
msgstr "%s: %q: no such variable %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:718
msgid "%s: stray $ in %q"
msgstr "%s: stray $ in %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:723
#, perl-format
msgid "%s: empty path"
msgstr "%s: empty path"

#. HEY!  %s is the option, as -Sarg_max=lots
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:846
#, perl-format
msgid "%s: expected a number of bytes, or auto"
msgstr "%s: expected a number of bytes, or auto"

#. HEY!  The first %s is where (as in the messages above), %s
#. the character (U+0041) and %s its spelling in bytes (0x5C).
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:918
#, perl-format
msgid ""
"%s: %s is encoded as %s in file system encoding%s, which contains ASCII "
"metacharacters"
msgstr ""
"%s: %s is encoded as %s in file system encoding%s, which contains ASCII "
"metacharacters"

#. HEY!  The first %s is always where (a file, or `file' line 3),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1022
msgid "%s: bad file name %q"
msgstr "%s: bad file name %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1026
msgid "%s: file name %q must be relative"
msgstr "%s: file name %q must be relative"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1029
msgid "%s: file name %q is out of tree"
msgstr "%s: file name %q is out of tree"

#. HEY!  %s is the option, as -Sclean=a,,b
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1067
#, perl-format
msgid "%s: a name of a rule may not be empty"
msgstr "%s: a name of a rule may not be empty"

#. HEY!  the second %s is the name, as in -Sclean=a:b
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1071
msgid "%s: %q cannot be the name of a rule"
msgstr "%s: %q cannot be the name of a rule"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1116
msgid "%s: %q is a reserved goal name"
msgstr "%s: %q is a reserved goal name"

#. HEY!  the second %s is a chain of
#. goals which ends in the beginning
#. node; e.g. `a -> b -> a'.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1144
#, perl-format
msgid "%s: cyclic goal: %s"
msgstr "%s: cyclic goal: %s"

#. HEY!  the second %s is a string literal, as ${"..."}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1241
#, perl-format
msgid "%s: junk after the string in %s"
msgstr "%s: junk after the string in %s"

#. HEY!  the second %s is what is in Makefile.in, as ${U+...}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1263
#, perl-format
msgid "%s: %s is not a valid Unicode code point"
msgstr "%s: %s is not a valid Unicode code point"

#. HEY!  the second %s is a variable, as ${@} (or ${.TARGET}),
#. in this message and in those that follow it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1270
#, perl-format
msgid "%s: %s outside of a recipe"
msgstr "%s: %s outside of a recipe"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1275
#, perl-format
msgid "%s: misplaced %s (not in a recipe)"
msgstr "%s: misplaced %s (not in a recipe)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1278
#, perl-format, perl-brace-format
msgid "%s: undefined %s (explicitly suppressed by ${a})"
msgstr "%s: undefined %s (explicitly suppressed by ${a})"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1285
#, perl-format
msgid "%s: undefined variable: %s"
msgstr "%s: undefined variable: %s"

#. HEY!  the second %s is where, as `a prerequisite'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1297
#, perl-format
msgid ":Q (shell quote) is not valid in %s"
msgstr ":Q (shell quote) is not valid in %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1298
msgid "a name"
msgstr "a name"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1299
msgid ":Q (shell quote) must be the last modifier"
msgstr ":Q (shell quote) must be the last modifier"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1304
msgid "a nested expansion"
msgstr "a nested expansion"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1330
msgid "a prerequisite"
msgstr "a prerequisite"

#. HEY!  The first %s is where, the second what is in Makefile.in
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1334
msgid "%s: %q expands to nothing"
msgstr "%s: %q expands to nothing"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1370
#, perl-brace-format
msgid "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"
msgstr "%s: %q: target is not preceded by a legal prefix (${b} or ${c})"

#. HEY!  the second %s is a variable, as ${name}
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1408
#, perl-format
msgid "%s: %s is already defined"
msgstr "%s: %s is already defined"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1424
msgid "a variable assignment"
msgstr "a variable assignment"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1436
msgid "an include path"
msgstr "an include path"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1440
msgid "%s: bad include path %q"
msgstr "%s: bad include path %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1467
msgid "%s: AUGMENT target %q has no rule"
msgstr "%s: AUGMENT target %q has no rule"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1488
#, perl-format
msgid "%s: AUGMENT may only amend dependencies"
msgstr "%s: AUGMENT may only amend dependencies"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1500
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:181
msgid "%s: cannot open file %q: %m"
msgstr "%s: cannot open file %q: %m"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1506
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:187
msgid "%s: include cycle through %q"
msgstr "%s: include cycle through %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1537
#, perl-format
msgid "%s: unfinished line continuation"
msgstr "%s: unfinished line continuation"

#. HEY!  a recipe line (one that begins with a tab)
#. with no rule above it to be the recipe of
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1547
#, perl-format
msgid "%s: unexpected tabulation"
msgstr "%s: unexpected tabulation"

#. HEY!  the second %s is the keyword: INCLUDE or AUGMENT
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1564
#: ../gengenlib/lib/RdKw/WwW/GenGenLib/Manifest.pm:245
#, perl-format
msgid "%s: %s takes at least one file"
msgstr "%s: %s takes at least one file"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1576
msgid "%s: invalid line: %q"
msgstr "%s: invalid line: %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1590
msgid "%s: more than one recipe for %q"
msgstr "%s: more than one recipe for %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1614
#, perl-format
msgid "%s: null target list"
msgstr "%s: null target list"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1654
msgid ""
"%s: %q: a prerequisite must start with NEED:, WANT:, JUST: (or JUST-NEED:) "
"or JUST-WANT:, not %q"
msgstr ""
"%s: %q: a prerequisite must start with NEED:, WANT:, JUST: (or JUST-NEED:) "
"or JUST-WANT:, not %q"

#. HEY!  %q is `NEED:' or `WANT:', literally.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1659
msgid "%s: %q something?"
msgstr "%s: %q something?"

#. HEY!  %s is the files, as `a' -> `b' -> `a'
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1694
#, perl-format
msgid "dependency cycle: %s"
msgstr "dependency cycle: %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1720
msgid "%q: %q is reserved for directory markers. (Set -De to change it.)"
msgstr "%q: %q is reserved for directory markers. (Set -De to change it.)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1742
msgid ""
"no rule to make it\n"
" (%q)."
msgstr ""
"no rule to make it\n"
" (%q)."

#. HEY!  the %s is where the rule is (e.g. `file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1748
msgid ""
"source %q is missing\n"
" (rule at %s)."
msgstr ""
"source %q is missing\n"
" (rule at %s)."

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1749
msgid "source %q is missing."
msgstr "source %q is missing."

#. HEY!  Keep the question mark: we are as puzzled as
#. anyone.  The (aka %q) is what the HAVE says, expanded
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1765
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q?"
msgstr ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1767
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q?"
msgstr ""
"%#q: You HAVE %q,\n"
"but I need %q?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1776
#, perl-format
msgid "prerequisite in %s"
msgstr "prerequisite in %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1778
#, perl-format
msgid "WANT: in %s"
msgstr "WANT: in %s"

#. HEY!  %s is where it was needed (in header of `file').
#. The same goes for the next two marked strings.
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1845
msgid ""
"NEEDs %q\n"
" (%s),\n"
"  but cannot be made:"
msgstr ""
"NEEDs %q\n"
" (%s),\n"
"  but cannot be made:"

#. HEY!  The last %q is the name it may have meant: a
#. header says MY/option.mk, when it is ${B}/MY/option.mk
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1857
msgid ""
"NEEDs %q\n"
" (%s),\n"
"  which we don't seem to have (is it %q?)"
msgstr ""
"NEEDs %q\n"
" (%s),\n"
"  which we don't seem to have (is it %q?)"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1859
msgid ""
"NEEDs %q\n"
" (%s),\n"
"  which we don't seem to have."
msgstr ""
"NEEDs %q\n"
" (%s),\n"
"  which we don't seem to have."

#. HEY!  The %s, in parentheses, is where it
#. was wanted (in header of `file').  The face
#. is yours to keep; i added it because "W"
#. felt like a weak indication of a soft dep
#. failing....
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1875
msgid ""
"target %q WANTs %q\n"
" (%s),\n"
"  but it is missing; going on without it. :("
msgstr ""
"target %q WANTs %q\n"
" (%s),\n"
"  but it is missing; going on without it. :("

#. HEY!  This is where a NEED (or a WANT) was said, and is
#. said in parentheses after what is needed: %q is the file,
#. and %d the line in it
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1904
msgid "in header of %q line %d"
msgstr "in header of %q line %d"

#. HEY!  As above, for a tool of the rule; the last %s
#. is where the rule is (`file' line 3)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1977
msgid ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%#q: You HAVE %q (aka %q),\n"
"but I need %q for the rule for %q (%s)?"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:1980
msgid ""
"%#q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"
msgstr ""
"%#q: You HAVE %q,\n"
"but I need %q for the rule for %q (%s)?"

#. HEY!  These three are where a goal says what it NEEDs (or
#. WANTs), in parentheses after it: %s is `file' line 3, and
#. %q the goal that has that line (which this goal includes)
#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2083
#, perl-format
msgid "in %s"
msgstr "in %s"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2084
msgid "in %s, via WANTed goal %q"
msgstr "in %s, via WANTed goal %q"

#: ../siteconf/lib/RdKw/WwW/SiteConf.pm:2085
msgid "in %s, via NEEDed goal %q"
