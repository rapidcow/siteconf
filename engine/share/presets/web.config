# The `web' preset: Template Toolkit static site generator.
# It insists on a site_url, and sees to it that it and
# base_url agree (and are in the shape `locate' expects).
#
# The script itself requires Template and GenLib for locate.
# At configure time, parse_base from GenLib is required.
#
# USE: RdKw::WwW::GenLib
# USE: Template

sub preset_finish
{
	my ($D, $O) = @_;
	$O->{base_url} = '/' unless defined $O->{base_url} && length $O->{base_url};
	defined $O->{site_url} && length $O->{site_url}
		or die "E: no site_url; configure with -Osite_url=https://example.org\n";
	eval { RdKw::WwW::GenLib::parse_base($O); 1 } or do {
		my $err = $@;
		$err =~ s/^/E: /mg;
		die $err;
	};
}
