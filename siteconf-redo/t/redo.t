#!perl
#
# t/redo.t - Makefile.in recipes as .do files

use strict;
use warnings;
use Test::More tests => 19;
# Pin LANGUAGE to C so gettext does not translate the messages matched below.
BEGIN { $ENV{LANGUAGE} = 'C' }
use RdKw::WwW::SiteConf::Backend::Redo;

my $class = 'RdKw::WwW::SiteConf::Backend::Redo';
sub files { my %f = map { @$_ } $class->emit($_[0]); \%f }

my $plan = {
	prog => 'test', args => [], D => { e => '.ok' },
	goals => [ { name => 'all', files => ['x'] } ],
	order => ['x'], dirs => [ { dir => 'site', marker => 'site/.ok', deps => [] } ],
	node => { x => { bpath => 'site/x', deps => [ 'in/x', 'a b', '-o', 'site/.ok' ],
		recipe => [ [ text => "\t\@cd .. && cp in/x site/x\n\t-rm junk \$\$HOME\n\tsed 's:a:b:' \\\n\t\tq\n", 'x' ] ] } },
};
my $f = files($plan);
is_deeply([ sort keys %$f ], [ 'all.do', 'site/x.do' ], 'a .do for the target, and for the goal');
my $do = $f->{'site/x.do'};
like($do, qr/^# \(generated by `test' :D\)$/m, 'header');
like($do, qr/^set -e\n/m, 'stops at a failure');
like($do, qr/^case \$3 in \/\*\) siteconf_out=\$3 ;; \*\) siteconf_out=\$PWD\/\$3 ;; esac\ncd \.\.\nexec >&2\n/m,
	'keeps $3, then goes to the build directory');
like($do, qr/^redo-ifchange in\/x 'a b' \.\/-o$/m, 'needs what it needs (quoted), but not the marker');
like($do, qr/^\( cd \.\. && cp in\/x site\/x \)$/m, 'a command of its own, @ dropped');
like($do, qr/^\( rm junk \$HOME \) \|\| true$/m, '- ignores failure; $$ is $');
like($do, qr/^\( sed 's:a:b:' \tq \)$/m, 'a backslash joins lines');
like($do, qr/\nmv -f -- site\/x "\$siteconf_out"\n\z/, 'the target is moved to $3');
is($f->{'all.do'} =~ /\n(set -e\nexec >&2\nredo-ifchange site\/x\n)\z/ && $1, "set -e\nexec >&2\nredo-ifchange site/x\n",
	'the goal needs its files, from the build directory');

{
	local $plan->{goals} = [ { name => 'site', files => ['x'] } ];
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name goal `site': a target or its directory/,
		'a goal cannot have the name of a directory of a target');
	local $plan->{goals} = [ { name => 'site/x', files => ['x'] } ];
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name goal `site\/x'/, '... or of a target');
}
{
	local $plan->{node}{x}{bpath} = '../out/x';
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name `\.\.\/out\/x': it is not in the build directory/,
		'a target out of the build directory');
}
{
	local $plan->{node}{x}{recipe} = [];
	ok(!eval { files($plan); 1 } && $@ =~ /no recipe/, 'no recipe, no .do');
}

{
	# A name is typed and is a file name: the same bytes, or an error
	require RdKw::I18N::CodeSets;
	local $plan->{node}{x}{bpath} = "site/r\x{e9}sum\x{e9}.html";
	local $RdKw::I18N::CodeSets::LOCALE =
		RdKw::I18N::CodeSets->locale->new(filesys => q(UTF-8), argv => q(UTF-8));
	ok(eval { files($plan); 1 }, q(UTF-8 for both: as it is)) or diag $@;
	$RdKw::I18N::CodeSets::LOCALE =
		RdKw::I18N::CodeSets->locale->new(filesys => q(UTF-8), argv => q(ISO-8859-1));
	ok(!eval { files($plan); 1 } && $@ =~ /redo cannot name .*: arguments and file names spell it differently/,
		q(UTF-8 file names, Latin-1 arguments: an error)) or diag $@;
}

is_deeply([ $class->build_command('redo', 'build', undef, 'all') ], [ qw[ ( cd build && redo all ) ] ], q(to build: cd to B, then redo goal));
is_deeply([ $class->build_command('redo', '.', undef, 'a b') ], [ q(redo), "'a b'" ], q(... quoted, and in B already));
is_deeply([ $class->build_command('redo', 'build', undef, undef) ], [ qw[ ( cd build && redo ) ] ], q(... or no goal));
